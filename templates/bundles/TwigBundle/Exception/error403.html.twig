{% extends 'base.html.twig' %}

{% block title %}
    Erreur 403
{% endblock %}

{% set header_text = 'var(--light)' %}
{% set header_text_scrolled = 'var(--light)' %}
{% set header_bg = 'var(--dark)' %}
{% set header_bg_scrolled = 'var(--dark)' %}
{% set header_logo = 'light' %}
{% set header_logo_scrolled = 'light' %}
{% set footer_bg = 'var(--light)' %}
{% set footer_text = 'var(--dark)' %}

{% block body %}

    <main class="w-full h-full p-5 bg-[var(--dark)] flex justify-center min-h-[100vh] py-[10%] md:py-[5%]">

        <section class="p-5 text-center bg-[#837261] py-[20%] md:py-[10%] px-[10%] w-[95%] flex items-center justify-center">
            <div class="flex flex-col items-center justify-center">
                <h1 class="text-center text-white text-5xl md:text-6xl mb-15 capitalize">Erreur 403</h1>

                <p class="text-white text-xl">Vous n'avez pas l'autorisation d'accéder à ce contenu</p>

                <p class="text-white text-xl">Retourner à <a class="underline" href="{{ path('app_main') }}">l'accueil</a></p>

            </div>

        </section>
    </main>

{% endblock %}
