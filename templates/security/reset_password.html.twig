{% extends 'base.html.twig' %}

{% block title %}Reinitialiser mon mot de passe{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="w-full bg-[var(--dark)] text-white flex flex-col items-center justify-center min-h-[100vh] border-b-2 border-[var(--light)]">

        {{ form(form, {
            attr : {
                'class' : 'form-dark w-[90vw] max-w-[1000px]'
        }
        }) }}

    </main>



{% endblock %}



