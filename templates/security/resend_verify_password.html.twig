{% extends 'base.html.twig' %}

{% block title %}
    Mail de confirmation envoyé
{% endblock %}

{% set header_text = 'var(--light)' %}
{% set header_text_scrolled = 'var(--light)' %}
{% set header_bg = 'var(--dark)' %}
{% set header_bg_scrolled = 'var(--dark)' %}
{% set header_logo = 'light' %}
{% set header_logo_scrolled = 'light' %}
{% set footer_bg = 'var(--light)' %}
{% set footer_text = 'var(--dark)' %}

{% block body %}

    <main class="w-full h-full p-5 bg-[var(--dark)] flex justify-center min-h-[100vh] py-[10%] md:py-[5%]">

        <section class="p-5 text-center bg-[#837261] py-[20%] md:py-[10%] px-[10%] w-[95%] flex items-center justify-center">
            <div class="flex flex-col items-center justify-center">
                <h1 class="text-center text-white text-5xl md:text-6xl mb-15">Mail de validation envoyé !</h1>

                <p class="mb-6 text-white md:w-1/2">Un mail de validation de compte vient de vous être envoyé sur votre adresse mail associée à votre compte. Pour le valider, veuillez cliquer sur le lien présent dans celui-ci.</p>

                {% set remaining = 0 %}
                {% if verification_email_sent_at %}
                    {% set elapsed = date().timestamp - verification_email_sent_at.timestamp %}
                    {% set remaining = max(0, 60 - elapsed) %}
                {% endif %}

                <p id="countdown-wrapper" class="text-white {{ remaining <= 0 ? 'hidden' }}">
                    Vous pourrez renvoyer le mail dans <span id="countdown">{{ remaining }}</span>s
                </p>

                <a
                id="resend-link"
                href="{{ path('app_verify_send') }}"
                class="border-1 border-white rounded-lg px-6 py-3 text-xl text-white mt-4 {{ remaining > 0 ? 'hidden' }}"
                >
                Renvoyer le mail
                </a>
            </div>

        </section>
    </main>

    <script>
        (function () {
            let remaining = {{ remaining }};

            const countdownEl = document.getElementById('countdown');
            const countdownWrapper = document.getElementById('countdown-wrapper');
            const resendLink = document.getElementById('resend-link');

            if (remaining <= 0) {
                return;
            }

            const interval = setInterval(function () {
                remaining--;
                countdownEl.textContent = remaining;

                if (remaining <= 0) {
                    clearInterval(interval);
                    countdownWrapper.classList.add('hidden');
                    resendLink.classList.remove('hidden');
                }
            }, 1000);
        })();
    </script>

{% endblock %}
