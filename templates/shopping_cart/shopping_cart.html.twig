{% extends 'base.html.twig' %}

{% block title %}
    Mon panier
{% endblock %}

{% set header_text = 'var(--light)' %}
{% set header_text_scrolled = 'var(--light)' %}
{% set header_bg = 'var(--dark)' %}
{% set header_bg_scrolled = 'var(--dark)' %}
{% set header_logo = 'light' %}
{% set header_logo_scrolled = 'light' %}
{% set footer_bg = 'var(--light)' %}
{% set footer_text = 'var(--dark)' %}

{% block body %}
    <main class="min-h-[100vh] flex justify-center pt-[15vh] bg-[var(--dark)] px-[var(--padX)] box-border">
        <div class="w-full max-w-[1200px] flex flex-col align-center">
            <section class="w-full pb-7">
                <h1 class="text-white text-4xl">Votre panier</h1>

                {% for message in app.flashes('error') %}
                    <div>{{ message }}</div>
                {% endfor %}
            </section>

            {% if shoppingCart is not empty %}

                <div class="text-white hidden md:flex ml-[130px] md:ml-[200px] px-12 box-border">
                    <span class="w-1/4 text-start pb-3">Produit</span>
                    <span class="w-1/4 text-center pb-3">Prix unitaire</span>
                    <span class="w-1/4 text-center pb-3">Quantité</span>
                    <span class="w-1/4 text-center pb-3">Total</span>
                </div>

                <div class="w-full border-b-2 border-white"></div>

                <section id="cart_filled" class="flex flex-col items-center mb-8 max-w-[1200px]">
                    {% for product in shoppingCart %}
                        <div class="w-full border-b md:border-b-2 border-white pb-4 md:py-5">

                            <div class="flex items-stretch w-full mt-5 mb-12 md:mb-0 md:mt-0">

                                {# Image — taille fixe, ne rétrécit/grandit jamais #}
                                <div class="w-[35%] max-w-[130px] shrink-0 md:max-w-[200px]">
                                    {% if product.image is not null %}
                                        <img
                                            src="{{ vich_uploader_asset(product.image, 'imageFile') }}"
                                            alt="{{ product.name }} - image"
                                            class="block w-full aspect-[3/4] object-cover"
                                        >
                                    {% else %}
                                        <img
                                            src="{{ asset('images/site/placeholder.jpg') }}"
                                            alt=""
                                            class="block w-full aspect-[3/4] object-cover"
                                        >
                                    {% endif %}
                                </div>

                                <div class="flex-1 min-w-0">
                                    {# Nom / prix / quantité (desktop) / total — prend tout le reste #}
                                    <div id="cart_product_{{ product.id }}" class="h-full px-3 md:px-12 text-white flex flex-col justify-between md:flex-row md:items-center md:h-[80%] md:pt-5 box-border"
                                    >

                                        <p class="text-2xl font-semibold leading-none break-words md:w-1/4 md:min-w-0 h-auto">
                                            {{ product.name|upper }}
                                        </p>

                                        <div class="flex flex-col md:w-1/4 md:flex-row md:justify-center">
                                            <span class="md:hidden">Prix</span>
                                            <span>{{ product.price }}€</span>
                                        </div>

                                        {# Sélecteur de quantité — visible uniquement en desktop ici #}
                                        <div class="hidden md:flex justify-center w-1/4 ">
                                            <div class="hidden md:flex items-center text-white my-5 p-1 border border-white rounded-xl w-auto max-w-[100px] md:justify-center w-[100px]">
                                                <form action="{{ path('app_shopping_cart_update') }}" method="post">
                                                    <input name="productId" type="hidden" value="{{ product.id }}">
                                                    <input name="action" type="hidden" value="false">
                                                    <input type="submit" value="-" class="ml-1">
                                                </form>

                                                <span class="px-3">{{ product.quantity }}</span>

                                                <form action="{{ path('app_shopping_cart_update') }}" method="post">
                                                    <input name="productId" type="hidden" value="{{ product.id }}">
                                                    <input name="action" type="hidden" value="true">
                                                    <input type="submit" value="+" class="mr-1">
                                                </form>
                                            </div>
                                        </div>


                                        {# Total ligne — desktop uniquement #}
                                        <div class="hidden md:flex flex-col md:w-1/4 md:flex-row md:justify-center">
                                            <span class="md:hidden">Total</span>
                                            <span>{{ product.totalPrice }}€</span>
                                        </div>

                                    </div>

                                    <form action="{{ path('app_shopping_cart_remove') }}" method="post" class=" hidden md:flex w-full justify-start px-12 h-[20%]">
                                        <input name="productId" type="hidden" value="{{ product.id }}">
                                        <input type="submit" value="Supprimer" class="text-white rounded py-1 underline text-end">
                                    </form>
                                </div>

                            </div>

                            {# Sélecteur de quantité — mobile uniquement #}
                            <div class="flex items-center justify-between w-full text-white my-5 p-3 border border-white rounded-xl md:hidden">
                                <form action="{{ path('app_shopping_cart_update') }}" method="post">
                                    <input name="productId" type="hidden" value="{{ product.id }}">
                                    <input name="action" type="hidden" value="false">
                                    <input type="submit" value="-" class="ml-5">
                                </form>

                                <span class="px-3">{{ product.quantity }}</span>

                                <form action="{{ path('app_shopping_cart_update') }}" method="post">
                                    <input name="productId" type="hidden" value="{{ product.id }}">
                                    <input name="action" type="hidden" value="true">
                                    <input type="submit" value="+" class="mr-5">
                                </form>
                            </div>

                            <form action="{{ path('app_shopping_cart_remove') }}" method="post" class="flex w-full justify-end md:hidden">
                                <input name="productId" type="hidden" value="{{ product.id }}">
                                <input type="submit" value="Supprimer" class="text-white rounded px-3 py-1 underline text-end">
                            </form>

                        </div>
                    {% endfor %}
                </section>

                <div class="flex flex-col py-5 w-full box-border">

                    <div class="text-white flex justify-between pb-4">
                        <span>Sous total</span>
                        <span id="cart_subtotal">{{ totalCart }}€</span>
                    </div>

                    <div class="text-white flex justify-between pb-4">
                        <span>Frais de livraison</span>
                        <span>À estimer</span>
                    </div>

                    <div class="text-white flex justify-between pb-4">
                        <span>Total estimé</span>
                        <span id="cart_total">{{ totalCart }}€</span>
                    </div>

                    <div class="text-white flex flex-col items-center mt-5 mb-10 md:items-end">
                        <a class="px-10 py-2 rounded-xl text-xl bg-white text-[var(--dark)] font-bold" href="{{ path('checkout_auth') }}">
                            Commander
                        </a>
                    </div>

                    <a class="underline self-end pt-[25px] text-white" href="{{ path('app_shopping_cart_empty') }}">
                        Vider le panier
                    </a>
                </div>

            {% else %}
                <section class="flex w-full items-center py-5 text-white box-border">
                    <p class="text-xl text-center w-full">Votre panier est vide, il est peut-être temps de vous faire plaisir.</p>
                </section>
            {% endif %}
        </div>

    </main>
{% endblock %}
