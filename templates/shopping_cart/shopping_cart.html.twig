                            </g>
                            <defs>
                                <clipPath id="clip0_475_1912">
                                    <rect width="162" height="192" fill="white"/>
                                </clipPath>
                            </defs>
                        </svg>

                        <div class="flex flex-col items-center justify-center text-center">
                            <h1 class="text-4xl py-8 px-12">Votre panier est vide</h1>
                            <hr class="w-1/2">
                            <p class="py-8">Votre rituel vous attend</p>

                            <button class="bg-[var(--light)] text-[var(--dark)] py-3 px-5 rounded-xl"><a href="{{ path('app_products') }}">Découvrir nos produits</a></button>
                        </div>
                    </section>


                    <section class="w-full py-10">
                        <div class="flex w-[100%]">
                            <img class="hidden md:block objet-cover aspect-4/3 w-1/4 p-2 border-box" src="{{ asset('images/site/fleur.png') }}" alt="">
                            <img class="objet-cover aspect-3/4 w-1/2 md:w-1/4 p-2 border-box" src="{{ asset('images/site/bouteille.png') }}" alt="">
                            <img class="objet-cover aspect-3/4 w-1/2 md:w-1/4 p-2 border-box" src="{{ asset('images/site/ouai.png') }}" alt="">
                            <img class="hidden md:block objet-cover aspect-4/3 w-1/4 p-2 border-box" src="{{ asset('images/site/pipette.png') }}" alt="">
                        </div>
                    </section>

                {% endif %}
            </div>

        </div>
    </main>
{% endblock %}
