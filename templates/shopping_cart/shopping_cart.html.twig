{% extends 'base.html.twig' %}

{% block title %}

{% endblock %}

{% block body %}

    <h2>PANIER</h2>

    {% for message in app.flashes('error') %}
        <div>{{ message }}</div>
    {% endfor %}


    {% if shoppingCart is not empty %}
        <section id="cart_filled" class="d-flex flex-column align-items-center">
        {% for product in shoppingCart %}

                <div id="cart_product_{{product.id }}" class="w-50 bg-light rounded-5 my-2 p-3">
                    <p>{{ product.name }}</p>

                    <div class="d-flex flex-row">
                        <form action="{{ path('app_shopping_cart_update') }}" method="post">
                            <input name="productId" type="hidden" value="{{ product.id }}">
                            <input name="action" type="hidden" value="false">
                            <input type="submit" value="-">
                        </form>
                        <span class="px-3">x {{ product.quantity }}</span>
                        <form action="{{ path('app_shopping_cart_update') }}" method="post">
                            <input name="productId" type="hidden" value="{{ product.id }}">
                            <input name="action" type="hidden" value="true">
                            <input type="submit" value="+">
                        </form>
                    </div>


                    <span>Prix unitaire : {{ product.price }}€</span>
                    <span>Sous total {{ product.totalPrice }}€</span>

                    <form action="{{ path('app_shopping_cart_remove') }}" method="post">
                        <input name="productId" type="hidden" value="{{ product.id }}">
                        <input type="submit" value="Supprimer" class="bg-danger">
                    </form>

                </div>
        {% endfor %}
        </section>
    <div class="d-flex flex-row py-5 mx-5">
        <span id="total_cart">Total : {{ totalCart }}€</span>

        <a class="px-5" href="{{ path('checkout_auth') }}">Valider mon panier</a>

        <a href="{{ path('app_shopping_cart_empty') }}">Vider le panier</a>
    </div>

    {% else %}
        <div class="d-flex w-100 align-items-center py-5">Votre panier est vide</div>
    {% endif %}


{% endblock %}

