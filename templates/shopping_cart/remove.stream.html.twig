<turbo-stream action="remove" target="cart_product_{{ productId }}">

</turbo-stream>

<turbo-stream action="replace" target="total_cart">

    <template>
        <span id="total_cart">Total : {{ totalCart }}€</span>
    </template>

</turbo-stream>

<turbo-stream action="replace" target="cart_quantity">

    <template>
        <span id="cart_quantity">{{ totalQuantityCart }}</span>
    </template>

</turbo-stream>

