<turbo-stream action="replace" target="cart_product_{{ productId }}">

    <template>
        <div id="cart_product_{{product.id }}">
            <p>{{ product.name }}</p>


            <form action="{{ path('app_shopping_cart_update') }}" method="post">
                <input name="productId" type="hidden" value="{{ product.id }}">
                <input name="action" type="hidden" value="false">
                <input type="submit" value="-">
            </form>
            <span>x {{ product.quantity }}</span>
            <form action="{{ path('app_shopping_cart_update') }}" method="post">
                <input name="productId" type="hidden" value="{{ product.id }}">
                <input name="action" type="hidden" value="true">
                <input type="submit" value="+">
            </form>

            <span>Prix unitaire : {{ product.price }}€</span>
            <span>Sous total {{ product.totalPrice }}€</span>

            <form action="{{ path('app_shopping_cart_remove') }}" method="post">
                <input name="productId" type="hidden" value="{{ product.id }}">
                <input type="submit" value="X">
            </form>


        </div>
    </template>

</turbo-stream>


<turbo-stream action="replace" target="total_cart">
    <template>
        <span id="total_cart">Total : {{ totalCart }}€</span>
    </template>
</turbo-stream>

<turbo-stream action="replace" target="cart_quantity">
    <template>
        <li id="cart_quantity">
            <a href="{{ path('app_shopping_cart_view') }}"><img src="{{ asset('icons/shopping_cart_24dp_3A3A3B_FILL0_wght400_GRAD0_opsz24.svg') }}" alt=""> {{ totalQuantityCart }} Mon panier</a>
        </li>
    </template>
</turbo-stream>
