{% extends 'base.html.twig' %}

{% block title %}
    Page d'accueil
{% endblock %}

{% block body %}

    <main>
        <section class="hero h-lvh flex justify-center">
            <img class="w-[70%] h-auto self-center text-white" src="{{ asset('images/site/logo-blanc.svg') }}" alt="">
        </section>

        <section class="home-evidence h-lvh md:h-[75vh] overflow-hidden md:flex md:flex-col md:flex-wrap">

            <img
                src="{{ asset('images/site/pou.png') }}"
                alt=""
                class="hidden md:block w-[50%] h-full object-cover"
            >

            <div class="md:w-[50%] h-full flex flex-col justify-between">
                <h2 class="text-4xl text-[#E4D8C5] pt-[10%] px-[5%] md:px-[45px] text-center md:text-[var(--dark-background)]">
                    Là où le soin devient une évidence
                </h2>

                <div class="home-button mb-[10%] w-[70%] md:w-[25%] bg-[var(--light-background)] text-[var(--dark-background)] md:bg-[var(--dark-background)] md:text-[var(--light-background)]">
                    Découvrir l'univers
                </div>
            </div>

        </section>

        <section class="home-essential w-full bg-[#453120] flex flex-col items-center">

            <div class="py-[10%] px-[5%] h-[20vh] flex items-center justify-center">
                <h2 class="text-4xl text-white">L'essentiel en un geste</h2>
            </div>

            <img
                class="w-[90%] h-auto mx-auto"
                src="{{ asset('images/site/rededed.png') }}"
                alt=""
            >

            <img
                class="w-[90%] h-auto mx-auto mt-[2%]"
                src="{{ asset('images/site/gtgt.png') }}"
                alt=""
            >

            <div class="h-[20vh] w-full flex items-center justify-center">
                <div class="home-button">Découvrir la routine</div>
            </div>



        </section>

        <section class="home-expert w-full h-[75vh] flex items-center justify-center">

            <h2 class="text-4xl text-white px-[5%] text-center">
                Une approche experte du soin intime
            </h2>

        </section>

        <section class="home-origin-vision">

            <div class="origin h-lvh">
                <div class="h-[45%] pt-[10%] px-[5%]">
                    <h3 class="text-4xl pb-[30px]">Origine : </h3>

                    <p class="text-xl">
                        Les soins dédiés à la zone intime restent encore peu considérés dans l’univers de la cosmétique, bien que cette zone nécessite une attention particulière.
                        <br>
                        C’est de ce constat qu’est née Lévédène.
                    </p>
                </div>


                <img class="w-[100%] h-[55%] object-cover" src="{{ asset('images/site/cuisse.png') }}" alt="">
            </div>

            <div class="vision h-lvh">
                <div class="h-[45%] pt-[10%] px-[5%]">
                    <h3 class="text-4xl pb-[30px]">Vision : </h3>

                    <p class="text-xl">
                        La marque développe des soins ciblés pour répondre aux problématiques les plus fréquentes de cette zone spécifique.
                        Une approche pensée pour identifier les déséquilibres de la peau - imperfections, inconforts, irrégularités - et y apporter des solutions adaptées.
                    </p>
                </div>

                <img class="w-[100%] h-[55%] object-cover" src="{{ asset('images/site/aqez.png') }}" alt="">

            </div>

        </section>

        <section class="home-universe bg-[#453120] text-white min-h-screen px-[5%] py-[5%] box-border">

            <h2 class="text-4xl pt-[40px]">Notre univers :</h2>

            <div class="flex justify-center flex-col h-[25%] border-b-5 border-white py-[25px]">
                <h3 class="text-3xl pb-[20px]">Expertise :</h3>

                <p class="text-xl">Une approche fondée sur une connaissance approfondie de la peau et de ses mécanismes, permettant de répondre aux besoins spécifiques de la zone intime.</p>

            </div>

            <div class="flex justify-center flex-col h-[25%] border-b-5 border-white py-[25px]">
                <h3 class="text-3xl pb-[20px]">Qualité : </h3>

                <p class="text-xl">Des soins développés avec exigences en laboratoire français, offrant performance, sécurité et tolérance.</p>

            </div>

            <div class="flex justify-center flex-col h-[25%] border-b-5 border-white py-[25px]">
                <h3 class="text-3xl pb-[20px]">Naturalité :</h3>

                <p class="text-xl">Des formules élaborées à partir d’ingrédients d’origine naturelle, rigoureusement sélectionnée pour leur affinité avec la peau.</p>

            </div>

            <div class="flex justify-center flex-col h-[25%] py-[25px]">
                <h3 class="text-3xl pb-[20px]">Bien-être</h3>

                <p class="text-xl">Une approche qui réconcilie, confort, confiance et intimité, dans une expérience à la fois apaisante et raffinée.</p>



            </div>


        </section>


    </main>

    <a href="{{ path('app_test_mail') }}">Test de mail</a>



{% endblock %}

