{% extends 'base.html.twig' %}

{% block title %}
    Page d'accueil
{% endblock %}

{% block body %}

    <main>
        <section class="hero h-dvh">
            <h1 class="text-5xl">Lévédène</h1>
        </section>

        <section class="home-evidence h-dvh">
            <h2 class="text-5xl text-[#E4D8C5]">Là où le soin devient une évidence</h2>

            <div class="home-button">Découvrir l'univers</div>
        </section>

        <section class="home-essential h-dvh w-full bg-[#453120]">

            <h2 class="text-5xl text-white">L'essentiel en un geste</h2>

            <img class="w-4/5" src="{{ asset('images/site/rededed.png') }}" alt="">

            <img class="w-4/5" src="{{ asset('images/site/gtgt.png') }}" alt="">

            <div class="home-button">Découvrir la routine</div>

        </section>

        <section class="home-expert h-dvh">

            <h2 class="text-5xl">Une approche experte du soin intime</h2>

        </section>

        <section class="home-origin-vision">

            <div class="origin h-dvh">
                <h3 class="text-5xl">Origine : </h3>

                <p>
                    Les soins dédiés à la zone intime restent encore peu considérés dans l’univers de la cosmétique, bien que cette zone nécessite une attention particulière.
                    <br>
                    C’est de ce constat qu’est née Lévédène.
                </p>

                <img src="{{ asset('images/site/cuisse.png') }}" alt="">
            </div>

            <div class="vision h-dvh">

                <h3 class="text-5xl">Vision : </h3>

                <p>
                    La marque développe des soins ciblés pour répondre aux problématiques les plus fréquentes de cette zone spécifique.
                    Une approche pensée pour identifier les déséquilibres de la peau - imperfections, inconforts, irrégularités - et y apporter des solutions adaptées.
                </p>

                <img src="{{ asset('images/site/aqez.png') }}" alt="">

            </div>

        </section>

        <section class="home-universe bg-[#453120] text-white h-[120vh]">

            <h2 class="text-5xl">Notre univers :</h2>

            <div>
                <h3 class="text-5xl">Expertise :</h3>

                <p>Une approche fondée sur une connaissance approfondie de la peau et de ses mécanismes, permettant de répondre aux besoins spécifiques de la zone intime.</p>

                <hr>

            </div>

            <div>
                <h3 class="text-5xl">Qualité : </h3>

                <p>Des soins développés avec exigences en laboratoire français, offrant performance, sécurité et tolérance.</p>

                <hr>

            </div>

            <div>
                <h3 class="text-5xl">Naturalité :</h3>

                <p>Des formules élaborées à partir d’ingrédients d’origine naturelle, rigoureusement sélectionnée pour leur affinité avec la peau.</p>

                <hr>

            </div>

            <div>
                <h3 class="text-5xl">Bien-être</h3>

                <p>Une approche qui réconcilie, confort, confiance et intimité, dans une expérience à la fois apaisante et raffinée.</p>

                <hr>

            </div>


        </section>


    </main>

    <a href="{{ path('app_test_mail') }}">Test de mail</a>



{% endblock %}

