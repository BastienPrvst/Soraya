{% mjml %}
    <mjml>
        <mj-head>
            <mj-font name="Staatliches" href="https://fonts.googleapis.com/css2?family=Staatliches&display=swap" />
            <mj-attributes>
                <mj-all font-family="Helvetica, Arial, sans-serif" />
                <mj-text color="#4a3f35" />
            </mj-attributes>
        </mj-head>

        <mj-body background-color="#e8ddc8" width="600px">

            <!-- Icône cadenas -->
            <mj-section padding="40px 20px 20px 20px">
                <mj-column>
                    <mj-image width="80px" src="{{ email.image('@images/lock.png') }}" alt="Mot de passe oublié" align="center" />
                </mj-column>
            </mj-section>

            <!-- Titre -->
            <mj-section padding="0 20px 20px 20px">
                <mj-column>
                    <mj-text align="center" font-family="Staatliches, Arial, sans-serif" font-size="22px" font-weight="bold" text-transform="uppercase" letter-spacing="1px">
                        Mot de passe oublié
                    </mj-text>
                </mj-column>
            </mj-section>

            <mj-section padding="0 60px">
                <mj-column>
                    <mj-divider border-color="#4a3f35" border-width="1px" />
                </mj-column>
            </mj-section>

            <!-- Corps du message -->
            <mj-section padding="30px 40px 10px 40px">
                <mj-column>
                    <mj-text align="center" font-size="14px" line-height="22px" padding-bottom="15px">
                        Bonjour {{ data.username|capitalize }}
                    </mj-text>
                    <mj-text align="center" font-size="14px" line-height="22px" padding-bottom="15px">
                        Vous avez demandé à réinitialiser le mot de passe de votre compte LÉVÉDÈNE.
                    </mj-text>
                    <mj-text align="center" font-size="14px" line-height="22px">
                        Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Bouton -->
            <mj-section padding="20px 20px 30px 20px">
                <mj-column>
                    <mj-button background-color="#4a3f35" color="#ffffff" border-radius="4px" href="{{ data.url }}" font-size="13px" padding="14px 30px">
                        RÉINITIALISER MON MOT DE PASSE
                    </mj-button>
                </mj-column>
            </mj-section>

            <!-- Note de sécurité -->
            <mj-section padding="10px 40px 30px 40px">
                <mj-column>
                    <mj-text align="center" font-size="13px" line-height="20px" color="#7a6b58">
                        Si vous n'êtes pas à l'origine de cette demande, vous pouvez simplement ignorer cet e-mail.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Footer -->
            <mj-section padding="0 20px 30px 20px">
                <mj-column>
                    <mj-text align="right" font-size="12px" color="#7a6b58" text-decoration="none">
                        Une question ? <a href="{{ data.contactUrl }}" style="color:#7a6b58; text-decoration:underline;">Contactez-nous</a>
                    </mj-text>
                </mj-column>
            </mj-section>

        </mj-body>
    </mjml>
{% endmjml %}
