{% mjml %}
    <mjml>
        <mj-head>
            <mj-font name="Iosevka Charon" href="https://fonts.googleapis.com/css2?family=Iosevka+Charon&display=swap" />
            <mj-font name="Staatliches" href="https://fonts.googleapis.com/css2?family=Staatliches&display=swap" />
            <mj-attributes>
                <mj-all font-family="Iosevka Charon, Arial, sans-serif" />
                <mj-text color="#4a3f35" />
            </mj-attributes>
        </mj-head>

        <mj-body background-color="#e8ddc8">

            <!-- Hero image full-width -->
            <mj-section full-width="full-width" padding="0">
                <mj-column>
                    <mj-image src="{{ email.image('@images/header_mail_account.png') }}" alt="Bienvenue" />
                </mj-column>
            </mj-section>

            <!-- Bloc contenu -->
            <mj-section full-width="full-width" background-color="#e8ddc8" padding="40px 20px">
                <mj-column width="500px">

                    <mj-text align="center" font-size="20px" font-weight="bold" text-transform="uppercase" padding-bottom="15px" font-family="Staatliches, Arial, sans-serif">
                        Bonjour {{ data.user.firstname|capitalize }}
                    </mj-text>

                    <mj-text align="center" font-size="14px" line-height="22px" padding-bottom="20px">
                        Vous pouvez dès maintenant retrouver vos informations, suivre vos commandes et accéder à votre espace personnel
                    </mj-text>

                    <mj-divider border-color="#4a3f35" border-width="1px" padding="0 0 20px 0" />

                    <!-- 3 icônes -->
                    <mj-section padding="0">
                        <mj-column width="33%">
                            <mj-image width="40px" src="{{ email.image('@images/feuille.png') }}" alt="" />
                            <mj-text align="center" font-size="13px" line-height="18px">
                                Des soins pensés<br>avec exigence
                            </mj-text>
                        </mj-column>
                        <mj-column width="33%">
                            <mj-image width="40px" src="{{ email.image('@images/coeur.png') }}" alt="" />
                            <mj-text align="center" font-size="13px" line-height="18px">
                                Un moment, rien que<br>pour vous
                            </mj-text>
                        </mj-column>
                        <mj-column width="33%">
                            <mj-image width="40px" src="{{ email.image('@images/goutte.png') }}" alt="" />
                            <mj-text align="center" font-size="13px" line-height="18px">
                                Une approche douce<br>et minimaliste
                            </mj-text>
                        </mj-column>
                    </mj-section>

                    <mj-button background-color="#4a3f35" color="#ffffff" border-radius="4px" href="{{ data.url }}" padding="30px 0 0 0">
                        ACCÉDER À MON COMPTE
                    </mj-button>

                </mj-column>
            </mj-section>

        </mj-body>
    </mjml>
{% endmjml %}
