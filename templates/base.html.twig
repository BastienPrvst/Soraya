<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Site Soraya{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>

    <body>
        {% include 'partials/header.html.twig' with {
            header_bg: header_bg|default(null),
            header_text: header_text|default(null),
            header_bg_scrolled: header_bg_scrolled|default(null),
            header_text_scrolled: header_text_scrolled|default(null)
        } %}
        <div class="flash-wrap">
            {{ include('partials/_flash.html.twig') }}
        </div>
        {% block body %}{% endblock %}
        {% include 'partials/footer.html.twig' with {
            footer_bg: footer_bg|default(null),
            footer_text: footer_text|default(null)
        } %}
    </body>
</html>
