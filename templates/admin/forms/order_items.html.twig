{% block order_item_row %}

    <div class="d-flex align-items-center py-3 px-2">
        <span style="font-size: 1.2rem;">📦</span>

        <div class="ps-2 flex-grow-1">
            <div style="font-size: 0.75rem; color: #6c757d; margin-bottom: 4px;">Produit</div>
            <strong style="color: #343a40;">
                {% for choice in form.product.vars.choices %}
                    {% if choice.value == form.product.vars.value %}
                        {{ choice.label }}
                    {% endif %}
                {% endfor %}
            </strong>
            {{ form_widget(form.product, {'attr': {'style': 'display:none'}}) }}
        </div>

        {# Séparateur #}
        <div style="width: 1px; height: 40px; background: #dee2e6;" class="my-1 mx-3"></div>

        {# Quantité #}
        <div class="d-flex align-items-center justify-content-center flex-row">
            <div class="pe-3">Quantité : </div>
            {{ form_widget(form.quantity, {'attr': {'style': 'width: 80px; text-align:center;'}}) }}
        </div>
        {{ form_rest(form) }}
    </div>
    <hr class="m-0">
{% endblock %}
