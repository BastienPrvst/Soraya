{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <main class="package-page w-full px-4">
        <div class="flex flex-wrap gap-4">
            <h1 class="mb-0 w-full">Emballer la commande {{ order.betterId }}</h1>
            <div class="w-full flex flex-wrap items-end">

                <small class="text-gray-500">{{ order.totalQuantity }} produit(s) à emballer</small>
                <small class="ml-auto text-gray-500">{{ numberToPrepare > 0 ? numberToPrepare ~ ' commandes restantes' : 'Dernière commande à préparer' }}</small>
            </div>

            {# Infos commande #}
            <section class="w-full lg:w-5/12">
                <div class="order-info-card">
                    <h2 class="text-lg mb-3">Informations commande</h2>
                    <ul>
                        <li><strong>Livraison</strong> : {{ order.deliveryMode.value|capitalize }}</li>
                        <li><strong>Prix livraison</strong> : {{ order.deliveryPrice > 0 ? order.deliveryPrice ~ ' €' : 'Gratuite' }}</li>
                        <li><strong>Total</strong> : {{ order.total }} €</li>
                        <li><strong>Transporteur</strong> :</li>
                    </ul>

                    <div class="order-address">
                        <strong>📦 Adresse de livraison</strong><br>
                        {{ order.activeAddress.street1 }}<br>
                        {% if order.activeAddress.street2 %}
                            {{ order.activeAddress.street2 }}<br>
                        {% endif %}
                        {{ order.activeAddress.zipcode }} {{ order.activeAddress.city }}<br>
                        {{ order.activeAddress.fullCountry }}
                        <br>

                        <div class="w-full flex justify-center mt-3">
                            <a href="#"
                               target="_blank"
                               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                                <i class="fa fa-print mr-2 mx-auto"></i>Imprimer l'étiquette
                            </a>
                        </div>


                    </div>
                </div>
            </section>

            {# Formulaire produits #}
            <section class="w-full lg:w-7/12">
                {{ form_start(form) }}

                <div class="flex flex-col gap-3 mb-4">
                    {% for field in form %}
                        {% if field.vars.name starts with 'item_' %}
                            <div>
                                <label class="item-button" for="{{ field.vars.id }}">
                                    <span class="item-name">
                                        {{ field.vars.attr['data-product-name']|capitalize }}
                                    </span>

                                    <span class="item-qty">
                                        Qté : {{ field.vars.attr['data-quantity'] }}
                                    </span>

                                    {{ form_widget(field) }}

                                    <span class="item-check">
                                        <i class="fa fa-check"></i>
                                    </span>
                                </label>

                                {{ form_errors(field) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="flex justify-center gap-3 mb-5">
                    {{ form_widget(form.validate) }}
                    {{ form_widget(form.validate_continue) }}
                </div>

                {{ form_end(form) }}
            </section>

        </div>
    </main>

{% endblock %}
