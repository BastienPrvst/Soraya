{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <main>
        <div class="stock-page">

            <h1>Gestion du stock de {{ product.name }}</h1>

            <div class="stock-form-card">
                <form
                    action="{{ path('admin_product_stock', { product: product.id }) }}"
                    method="post"
                    id="stock-form"
                    class="flex flex-col"
                >
                    <p class="stock-current">Stock actuel : {{ product.stock }}</p>

                    <div class="stock-field">
                        <label for="add-stock">Quantité à ajouter</label>
                        <input type="number" name="add-stock" id="add-stock"
                               oninput="document.getElementById('remove-stock').disabled = this.value !== ''">
                    </div>

                    <div class="stock-field">
                        <label for="remove-stock">Quantité à supprimer</label>
                        <input type="number" name="remove-stock" id="remove-stock"
                               oninput="document.getElementById('add-stock').disabled = this.value !== ''">
                    </div>

                    <button type="button"
                            data-action="click->modal#open"
                            data-modal-id-param="confirm-stock-modal"
                            class="self-center mt-2 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                        Valider
                    </button>

                </form>
            </div>

            {# Modale de confirmation #}
            <div class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50" id="confirm-stock-modal" data-controller="modal">
                <div class="bg-white rounded-lg shadow-lg w-full max-w-md mx-auto">

                    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
                        <h5 class="text-lg font-semibold">Confirmer la modification du stock</h5>
                        <button type="button" class="text-2xl leading-none text-gray-500 hover:text-gray-800" data-action="click->modal#close">&times;</button>
                    </div>

                    <div class="px-4 py-4">
                        Êtes-vous sûr de vouloir modifier le stock de <strong>{{ product.name }}</strong> ?
                    </div>

                    <div class="flex justify-end gap-2 px-4 py-3 border-t border-gray-200">
                        <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600" data-action="click->modal#close">
                            Annuler
                        </button>
                        <button type="submit" form="stock-form" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">
                            Confirmer
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </main>


{% endblock %}
