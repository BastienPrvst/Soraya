{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <main class="w-full px-4 main-dashboard">
        <div class="flex flex-wrap admin-wrapper">
            <h1 class="admin-title mt-3">Bonjour, {{ app.user.firstname|capitalize }}</h1>

            <div class="crud-links">
                <div class="quick-crud">
                    <a href="{{ toPrepareUrl }}">
                        <p class="crud-link-label">À emballer</p>
                        <p class="crud-link-number">{{ countPrepare }}</p>
                    </a>
                </div>

                <div class="quick-crud">
                    <a href="{{ toShipUrl }}">
                        <p class="crud-link-label">À expédier</p>
                        <p class="crud-link-number">{{ countPendingShipping }}</p>
                    </a>
                </div>

                <div class="quick-crud">
                    <a href="{{ toRefundUrl }}">
                        <p class="crud-link-label">Remboursements</p>
                        <p class="crud-link-number">{{ countRefunded }}</p>
                    </a>
                </div>

                <div class="quick-crud">
                    <a href="{{ toCancelUrl }}">
                        <p class="crud-link-label">Annulées</p>
                        <div class="crud-link-div">
                            <p class="crud-link-number">{{ countCancelled }}</p>
                            <p class="crud-link-text">Cette semaine</p>
                        </div>

                    </a>
                </div>

            </div>

            <div class="user-info">
                <div class="other-links">
                    <p>Liens</p>

                    <div>
                        <a href="{{ stripe_dashboard_url }}" target="_blank"> Dashboard Stripe </a>

                        <span class="link-logos"><img src="{{ asset('icons/stripe.svg') }}" alt="logo stripe"></span>
                    </div>

                    <div>
                        <a href="#">Mondial Relay</a>

                        <span class="link-logos"><img src="{{ asset('icons/mondial_relay.svg') }}" alt="logo mondial relay"></span>
                    </div>

                    <div>
                        <a href="#">Colissimo</a>

                        <span class="link-logos"><img src="{{ asset('icons/Colissimo_Logo.svg') }}" alt="logo colissimo">
                            </span>
                    </div>

                </div>

                <div class="parameters">
                    <p>Paramètres</p>

                    <span>Adresse mail admin : {{ parameters.adminMail ?? 'Non renseignée' }}</span>

                    <span>Stock critique : {{ parameters.criticalStock }}</span>

                    <a href="#"><i class="fa-solid fa-gear"></i></a>

                </div>
            </div>




            <div class="year-select">
                <div class="dropdown-years relative" data-controller="dropdown">
                    <button class="px-3 py-2 bg-gray-500 text-white rounded-md" type="button" data-action="click->dropdown#toggle">
                        {{ selectedYear }}
                    </button>
                    <ul class="hidden absolute mt-1 bg-white border border-gray-200 rounded-md shadow-lg" data-dropdown-target="menu">
                        {% for year in years %}
                            <li>
                                <a class="block px-4 py-2 hover:bg-gray-100 {{ year == selectedYear ? 'bg-gray-100 font-semibold' : '' }}"
                                   href="{{ path('admin', { year: year }) }}">
                                    {{ year }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="chart1 chart-container">
                {{ render_chart(chart) }}
            </div>

            <div class="chart2 chart-container">
                {{ render_chart(chart2) }}
            </div>

            <div class="chart3 chart-container">

                <div class="year-select">
                    <div class="dropdown-years relative" data-controller="dropdown">
                        <button class="px-3 py-2 bg-gray-500 text-white rounded-md" type="button" data-action="click->dropdown#toggle">
                            {{ months[selectedMonth] }}
                        </button>
                        <ul class="hidden absolute mt-1 bg-white border border-gray-200 rounded-md shadow-lg" data-dropdown-target="menu">
                            {% for value, label in months %}
                                <li>
                                    <a class="block px-4 py-2 hover:bg-gray-100 {{ value == selectedMonth ? 'bg-gray-100 font-semibold' : '' }}"
                                       href="{{ path('admin', { year: selectedYear, month: value }) }}">
                                        {{ label }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                {{ render_chart(chart3) }}
            </div>

        </div>


    </main>



{% endblock %}
