{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <div class="d-flex flex-column justify-content-center align-items-center">
        <h1>Bonjour, {{ app.user.firstname|capitalize }}</h1>


        <div>
            <div >
                <a class="d-flex flex-column align-items-center justify-content-center my-3" href="{{ toPrepareUrl }}">
                    <p>Commandes à emballer :</p>
                    <p>{{ countPrepare }}</p>
               </a>
            </div>

            <div >
                <a class="d-flex flex-column align-items-center justify-content-center my-3" href="{{ toShipUrl }}">
                    <p>Commandes à expédier :</p>
                    <p>{{ countPendingShipping }}</p>
                </a>
            </div>
        </div>

        <div>
            Liens :

            <a href="{{ stripe_dashboard_url }}" target="_blank">Dashboard Stripe </a>
            <a href="#">Mondial Relay</a>
            <a href="#">Collisimo</a>
        </div>

        <div class="mb-3">
            {% for year in years %}
                <a href="{{ path('admin', { year: year }) }}"
                   class="btn btn-sm {{ year == selectedYear ? 'btn-primary' : 'btn-outline-secondary' }}">
                    {{ year }}
                </a>
            {% endfor %}
        </div>

        <div class="chart" style="width: 800px">
            {{ render_chart(chart) }}
        </div>

    </div>


{% endblock %}

