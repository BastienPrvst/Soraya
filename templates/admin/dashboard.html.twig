{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <main class="container-fluid main-dashboard">
        <div class="row">
            <h1 class="mt-3 ms-3">Bonjour, {{ app.user.firstname|capitalize }}</h1>

            <section class="admin-s1 col-12 my-3">

                <div class="crud-links">
                    <div class="quick-crud p-3 rounded-4">
                        <a class="d-flex flex-column align-items-center justify-content-center" href="{{ toPrepareUrl }}">
                            <p>À emballer</p>
                            <p class="crud-link-number">{{ countPrepare }}</p>
                        </a>
                    </div>

                    <div class="quick-crud p-3 rounded-4">
                        <a class="d-flex flex-column align-items-center" href="{{ toShipUrl }}">
                            <p>À expédier</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>

                    <div class="quick-crud p-3 rounded-4">
                        <a class="d-flex flex-column align-items-center justify-content-center" href="{{ toShipUrl }}">
                            <p>Annulées</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>

                    <div class="quick-crud p-3 rounded-4">
                        <a class="d-flex flex-column align-items-center justify-content-center" href="{{ toShipUrl }}">
                            <p>Remboursements</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>
                </div>

            </section>

            <section class="admin-s2 d-flex flex-row p-3">


                <div class="mb-3">
                    {% for year in years %}
                        <a href="{{ path('admin', { year: year }) }}"
                           class="btn btn-sm {{ year == selectedYear ? 'btn-primary' : 'btn-outline-secondary' }}">
                            {{ year }}
                        </a>
                    {% endfor %}
                </div>

                <div class="chart" style="width: 45%">
                    {{ render_chart(chart) }}
                </div>

                <div class="chart" style="width: 45%">
                    {{ render_chart(chart2) }}
                </div>

            </section>

        </div>

        <footer>
            <div>
                Liens :

                <a href="{{ stripe_dashboard_url }}" target="_blank">Dashboard Stripe </a>
                <a href="#">Mondial Relay</a>
                <a href="#">Collisimo</a>
            </div>
        </footer>
    </main>



{% endblock %}

