{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

    <main class="container-fluid main-dashboard">
        <div class="row admin-wrapper">
            <h1 class="admin-title mt-3">Bonjour, {{ app.user.firstname|capitalize }}</h1>

                <div class="crud-links">
                    <div class="quick-crud">
                        <a href="{{ toPrepareUrl }}">
                            <p class="crud-link-label">À emballer</p>
                            <p class="crud-link-number">{{ countPrepare }}</p>
                        </a>
                    </div>

                    <div class="quick-crud">
                        <a href="{{ toShipUrl }}">
                            <p class="crud-link-label">À expédier</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>

                    <div class="quick-crud">
                        <a href="{{ toShipUrl }}">
                            <p class="crud-link-label">Annulées</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>

                    <div class="quick-crud">
                        <a href="{{ toShipUrl }}">
                            <p class="crud-link-label">Remboursements</p>
                            <p class="crud-link-number">{{ countPendingShipping }}</p>
                        </a>
                    </div>
                </div>

                    <div class="other-links">
                        <p>Liens</p>

                        <div>
                            <a href="{{ stripe_dashboard_url }}" target="_blank"> Dashboard Stripe </a>

                            <span class="link-logos"><img src="{{ asset('icons/stripe.svg') }}" alt="logo stripe"></span>
                        </div>

                        <div>
                            <a href="#">Mondial Relay</a>

                            <span class="link-logos"><img src="{{ asset('icons/mondial_relay.svg') }}" alt="logo mondial relay"></span>
                        </div>

                        <div>
                            <a href="#">Colissimo</a>

                            <span class="link-logos"><img src="{{ asset('icons/Colissimo_Logo.svg') }}" alt="logo colissimo">
                    </span>
                        </div>

                    </div>


                    <div class="year-select">
                        {% for year in years %}
                            <a href="{{ path('admin', { year: year }) }}"
                               class="btn btn-sm {{ year == selectedYear ? 'btn-primary' : 'btn-outline-secondary' }}">
                                {{ year }}
                            </a>
                        {% endfor %}
                    </div>

                    <div class="chart1 chart-container">
                        {{ render_chart(chart) }}
                    </div>

                    <div class="chart2 chart-container">
                        {{ render_chart(chart2) }}
                    </div>

        </div>


    </main>



{% endblock %}

