{% extends 'base.html.twig' %}

{% block title %}
    {{ product.name|capitalize }} - Lévédène
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="bg-[var(--light)]">

        <section class="min-h-[80vh] mb-[5vh] md:flex pt-[15%]">
            <div>
                <h1 class="text-center text-wrap text-4xl px-[5%] text-[var(--dark)] md:flex-order-2"> {{ product.name|capitalize }} </h1>

                {# Carousel des images du produit #}
                <div class="w-[95%] max-w-md mx-auto mt-8">

                    {# Carousel principal #}
                    <div class="swiper main-swiper h-[60vh]">
                        <div class="swiper-wrapper">
                            {% for img in product.images %}
                                <div class="swiper-slide">
                                    <img
                                        src="{{ vich_uploader_asset(img, 'imageFile') }}"
                                        alt="{{ product.name }} - image {{ loop.index }}"
                                        class="w-full h-full object-cover"
                                    >
                                </div>
                            {% endfor %}
                        </div>

                        <div class="swiper-button-prev !text-[var(--dark)]"></div>
                        <div class="swiper-button-next !text-[var(--dark)]"></div>
                    </div>

                    {# Miniatures — visibles à partir de md #}
                    {% if product.images|length > 1 %}
                        <div class="swiper thumb-swiper !hidden md:!block mt-4 opacity-0 transition-opacity duration-200">
                            <div class="swiper-wrapper">
                                {% for img in product.images %}
                                    <div class="swiper-slide aspect-square cursor-pointer opacity-50">
                                        <img
                                            src="{{ vich_uploader_asset(img, 'imageFile') }}"
                                            alt="{{ product.name }} - miniature {{ loop.index }}"
                                            class="w-full h-full object-cover"
                                        >
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                </div>
            </div>

            <div class="px-4 w-full md:min-h-[100%] md:flex-order-3">
                <div class="flex flex-col border-b-2 border-[var(--dark)] h-full">

                    <h2 class="text-[var(--dark)] text-3xl pb-3">Description :</h2>

                    <p>{{ product.smallDescription|raw }}</p> <br>

                    <div class="flex w-full justify-between items-center">
                        <span class="border-1 rounded-xl p-1">30ml</span>
                        <span class="text-xl">{{ product.price }}€</span>
                    </div>

                    {% if product.stock > 0 %}
                        <button id="buy-button" class="self-end buy-button text-lg bg-white rounded-lg p-2 my-[25px]">Ajouter au panier</button>
                    {% else %}
                        <button id="buy-button" class="self-end buy-button" disabled>Rupture</button>
                    {% endif %}

                </div>
            </div>
        </section>


        <section class="px-4 w-full">

            <div class="border-b-2 border-[var(--dark)] pb-6 mb-2">
                <h3 class="text-xl py-5">Description :</h3>

                {{ product.description|raw }}
            </div>

            <div class="product-collapse border-b-2 border-[var(--dark)]">
                <h3 class="uppercase">
                    <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                        Ingrédients :
                    <span class="collapse-icon shrink-0"></span>
                    </button>
                </h3>
                <div class="collapse-content">
                    <div class="collapse-inner">
                        {{ product.ingredients|raw }}
                    </div>
                </div>
            </div>

            <div class="product-collapse border-b-2 border-[var(--dark)]">
                <h3 class="uppercase">
                    <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                        Conseils d'utilisation
                        <span class="collapse-icon shrink-0"></span>
                    </button>
                </h3>
                <div class="collapse-content">
                    <div class="collapse-inner">
{#                        {{ product.usageAdvice|raw }}#}
                    </div>
                </div>
            </div>

            <div class="product-collapse border-b-2 border-[var(--dark)]">
                <h3 class="uppercase">
                    <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                        Bienfaits :
                        <span class="collapse-icon shrink-0"></span>
                    </button>
                </h3>
                <div class="collapse-content">
                    <div class="collapse-inner">
                        {{ product.benefits|raw }}
                    </div>
                </div>
            </div>

            <div class="product-collapse border-b-2 border-[var(--dark)]">
                <h3 class="uppercase">
                    <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                        Conseils ciblés :
                        <span class="collapse-icon shrink-0"></span>
                    </button>
                </h3>
                <div class="collapse-content">
                    <div class="collapse-inner">
{#                        {{ product.|raw }}#}
                    </div>
                </div>
            </div>

        </section>

        <section class="px-4 w-full py-[10vh]">
            <div class="flex flex-col">
                <img class="aspect-3/4 w-full" src="{{ asset('images/site/bottle.png') }}" alt="">
                <img class="aspect-3/4 w-full" src="{{ asset('images/site/pile.png') }}" alt="">
            </div>
        </section>



    </main>

{% endblock %}

{% block javascripts %}

    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const thumbSwiper = new Swiper('.thumb-swiper', {
                slidesPerView: 3,
                spaceBetween: 12,
                watchSlidesProgress: true,
            });

            const mainSwiper = new Swiper('.main-swiper', {
                spaceBetween: 0,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                thumbs: {
                    swiper: thumbSwiper,
                },
            });

            document.querySelector('.thumb-swiper')?.classList.remove('opacity-0');
        });
    </script>

{% endblock %}




