{% extends 'base.html.twig' %}

{% block title %}
    {{ product.name|capitalize }} - Lévédène
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="bg-[var(--light)]">

        <section class="px-[clamp(1rem,3vw,4rem)] mb-[5vh] pt-[20%] md:pt-[7%] lg:pt-[5%]">

            <div class="md:flex md:flex-col flex-wrap md:max-h-[100vh] md:items-center">
                <h1 class="text-center text-wrap text-4xl text-[var(--dark)] md:order-2 md:w-[45%] md:pt-[10%] md:text-start md:border-b-2 md:border-[var(--dark)] md:pb-5"> {{ product.name|capitalize }} </h1>

                {# Carousel des images du produit #}
                <div class="w-full max-w-md mx-auto my-8 md:order-1 md:h-[100vh] box-border md:w-[50%] md:pr-5 xl:mx-0 xl:h-max">

                    {# Carousel principal #}
                    <div class="swiper main-swiper h-[60vh]">
                        <div class="swiper-wrapper">
                            {% for img in product.images %}
                                <div class="swiper-slide">
                                    <img
                                        src="{{ vich_uploader_asset(img, 'imageFile') }}"
                                        alt="{{ product.name }} - image {{ loop.index }}"
                                        class="w-full h-full object-cover"
                                    >
                                </div>
                            {% endfor %}
                        </div>

                        <div class="swiper-button-prev !text-[var(--dark)]"></div>
                        <div class="swiper-button-next !text-[var(--dark)]"></div>
                    </div>

                    {# Miniatures — visibles à partir de md #}
                    {% if product.images|length > 1 %}
                        <div class="swiper thumb-swiper !hidden md:!block mt-1 opacity-0 transition-opacity duration-200">
                            <div class="swiper-wrapper h-auto">
                                {% for img in product.images %}
                                    <div class="swiper-slide cursor-pointer opacity-50 aspect-3/4">
                                        <img
                                            src="{{ vich_uploader_asset(img, 'imageFile') }}"
                                            alt="{{ product.name }} - miniature {{ loop.index }}"
                                            class="w-full h-full object-cover"
                                        >
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                </div>

                <div class="px-[clamp(1rem,3vw,4rem)] w-full md:min-h-[100%] md:order-3 md:w-[45%] md:px-0 md:h-[75%]">
                    <div class="flex flex-col h-full md:justify-between">

                        <div class="md:pt-8">
                            <h2 class="text-[var(--dark)] text-3xl pb-3">Description :</h2>

                            <p>{{ product.smallDescription|raw }}</p> <br>
                        </div>
                        <span class="border-1 rounded-xl p-1 text-center w-min mb-8">{{ product.capacity }}</span>



                            <form action="{{ path('app_shopping_cart_add', {pageId : product.id}) }}" method="post" class="flex justify-between items-center flex-wrap pb-6">
                                <input name="productId" type="hidden" value="{{ product.id }}">
                                <input id="quantity-input" name="quantity" type="hidden" value="1">

                                <span class="text-xl w-full pl-3">{{ product.price }}€</span>

                                <div class="inline-flex items-center border border-[var(--dark)] rounded-lg px-4 py-2 gap-4">
                                    <button type="button" onclick="updateQty(-1)" class="appearance-none bg-transparent border-0 p-0 m-0 text-lg leading-none cursor-pointer">−</button>
                                    <span id="quantity-display" class="text-base w-4 text-center leading-none">1</span>
                                    <button type="button" onclick="updateQty(1)" class="appearance-none bg-transparent border-0 p-0 m-0 text-lg leading-none cursor-pointer">+</button>
                                </div>

                                {% if product.stock > 0 %}

                                    <input class="self-end buy-button text-lg bg-white rounded-lg py-3 px-5 cursor-pointer hover:bg-[var(--dark)] hover:text-white transition delay-50 ease-in-out" type="submit" value="Ajouter au panier">
                                {% else %}
                                    <input class="self-end buy-button text-lg bg-white rounded-lg py-3 px-5 cursor-pointer hover:bg-[var(--dark)] hover:text-white transition delay-50 ease-in-out"  disabled type="submit" value="Rupture">
                                {% endif %}
                            </form>

                    </div>
                </div>


            </div>

            <div class="w-full border-b-2 border-[var(--dark)]"></div>

        </section>


        <section class="px-[clamp(1rem,3vw,4rem)] w-full">

            <div class="border-b-2 border-[var(--dark)] pb-6 mb-2">
                <h3 class="text-xl py-5">Description :</h3>

                {{ product.description|raw }}
            </div>

            {% if product.ingredients %}
                <div class="product-collapse border-b-2 border-[var(--dark)]">
                    <h3 class="uppercase">
                        <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                            Ingrédients :
                            <span class="collapse-icon shrink-0"></span>
                        </button>
                    </h3>
                    <div class="collapse-content">
                        <div class="collapse-inner">
                            {{ product.ingredients|raw }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if product.useAdvice %}
                <div class="product-collapse border-b-2 border-[var(--dark)]">
                    <h3 class="uppercase">
                        <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                            Conseils d'utilisation
                            <span class="collapse-icon shrink-0"></span>
                        </button>
                    </h3>
                    <div class="collapse-content">
                        <div class="collapse-inner">
                            {{ product.useAdvice|raw }}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if product.benefits %}
                <div class="product-collapse border-b-2 border-[var(--dark)]">
                    <h3 class="uppercase">
                        <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                            Bienfaits :
                            <span class="collapse-icon shrink-0"></span>
                        </button>
                    </h3>
                    <div class="collapse-content">
                        <div class="collapse-inner">
                            {{ product.benefits|raw }}
                        </div>
                    </div>
                </div>
            {% endif %}



            {% if product.targetAdvice %}
                <div class="product-collapse border-b-2 border-[var(--dark)]">
                    <h3 class="uppercase">
                        <button type="button" class="collapse-trigger flex items-center justify-between w-full py-4 text-left">
                            Conseils ciblés :
                            <span class="collapse-icon shrink-0"></span>
                        </button>
                    </h3>
                    <div class="collapse-content">
                        <div class="collapse-inner">
                            {{ product.targetAdvice|raw }}
                        </div>
                    </div>
                </div>
            {% endif %}



        </section>

        <section class="px-[clamp(1rem,5vw,4rem)] w-full py-[10vh]">
            <div class="flex flex-col md:flex-row">
                <img class="aspect-3/4 w-full md:w-1/3 h-auto" src="{{ asset('images/site/bottle.png') }}" alt="">
                <img class="aspect-3/4 w-full md:w-1/3" src="{{ asset('images/site/pile.png') }}" alt="">
                <img class="aspect-3/4 w-full hidden md:block md:w-1/3" src="{{ asset('images/site/goutte.png') }}" alt="">
            </div>
        </section>



    </main>

{% endblock %}

{% block javascripts %}

    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const thumbSwiper = new Swiper('.thumb-swiper', {
                slidesPerView: 3,
                spaceBetween: 12,
                watchSlidesProgress: true,
            });

            const mainSwiper = new Swiper('.main-swiper', {
                spaceBetween: 0,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                thumbs: {
                    swiper: thumbSwiper,
                },
            });

            document.querySelector('.thumb-swiper')?.classList.remove('opacity-0');

            const collapses = document.querySelectorAll('.product-collapse');

            collapses.forEach((collapse) => {
                const trigger = collapse.querySelector('.collapse-trigger');

                trigger.addEventListener('click', () => {
                    const isOpen = collapse.classList.contains('is-open');
                    collapse.classList.toggle('is-open', !isOpen);
                    trigger.setAttribute('aria-expanded', String(!isOpen));
                });
            });
        });

        function updateQty(delta) {
            const input = document.getElementById('quantity-input');
            const display = document.getElementById('quantity-display');
            let value = parseInt(input.value) + delta;
            if (value < 1) value = 1;
            input.value = value;
            display.textContent = value;
        }
    </script>

{% endblock %}




