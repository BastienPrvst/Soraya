{% extends 'base.html.twig' %}


{% block title %}
    Les produits
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_text_scrolled = 'var(--dark)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set header_logo_scrolled = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}
    <main class="bg-[var(--light)]">

        <section class="products-hero h-[60vh]">
        </section>

        <turbo-frame id="products-frame">

            <section id="anchor" class="w-full sm:flex sm:flex-wrap px-[var(--padX)] py-15">
                {% for product in products %}
                    <a class="w-full sm:w-1/2 lg:w-1/4 py-8 block" href="{{ path('app_product_details', { name: product.name }) }}" data-turbo-frame="_top">

                        <div>
                            <div class="w-full sm:p-4 aspect-3/4">
                                {% if product.mainImage %}
                                    <img
                                        src="{{ vich_uploader_asset(product.mainImage, 'imageFile') }}"
                                        alt="{{ product.name }} - image {{ loop.index }}"
                                        class="w-full h-full object-cover"
                                    >
                                {% else %}
                                    <img
                                        src="{{ asset('images/site/placeholder.jpg') }}"
                                        alt="{{ product.name }} - image indisponible"
                                        class="w-full h-full object-cover"
                                    >
                                {% endif %}
                            </div>


                            <div class="p-5">
                                <p class="pb-2">{{ product.name|capitalize }}</p>
                                <div class="flex justify-between">
                                    <p>{{ product.capacity }}</p>
                                    <p>{{ product.price }}€</p>
                                </div>
                            </div>

                        </div>
                    </a>
                {% endfor %}

                {% if products|length < limit %}
                    {% for i in 1..(limit - products|length) %}
                        <div class="hidden lg:block lg:invisible w-full lg:w-1/4 py-8" aria-hidden="true">
                            <div>
                                <div class="w-full sm:p-4 aspect-3/4"></div>
                                <div class="p-5">
                                    <p class="pb-2">&nbsp;</p>
                                    <div class="flex justify-between">
                                        <p>&nbsp;</p>
                                        <p>&nbsp;</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </section>

            <section class="w-full pb-8">
                <nav class="w-full grid grid-cols-3 items-center px-[var(--padX)]">

                    <div class="justify-self-end">
                        {% if currentPage > 1 %}
                            <a href="{{ path('app_products', {'page': currentPage - 1}) }}#anchor">&laquo; Précédent</a>
                        {% endif %}
                    </div>

                    <div class="justify-self-center flex">
                        {% for page in 1..totalPages %}
                            <a href="{{ path('app_products', {'page': page}) }}#anchor"
                               class="{{ page == currentPage ? 'active' : 'underline' }} px-4">
                                {{ page }}
                            </a>
                        {% endfor %}
                    </div>

                    <div>
                        {% if currentPage < totalPages %}
                            <a href="{{ path('app_products', {'page': currentPage + 1}) }}#anchor">Suivant &raquo;</a>
                        {% endif %}
                    </div>

                </nav>
            </section>
        </turbo-frame>
    </main>
{% endblock %}

{% block javascripts %}

    {{ parent() }}

    <script>
        document.addEventListener("turbo:frame-load", (event) => {
            if (event.target.id === "products-frame") {
                document.getElementById("anchor")?.scrollIntoView({ behavior: "smooth", block: "start" });
            }
        });
    </script>

{% endblock %}

