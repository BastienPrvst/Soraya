{% extends 'base.html.twig' %}


{% block title %}
    Les produits
{% endblock %}

{% block body %}
    <main>

        <h1>Les Produits</h1>

        <div data-controller="test">
            Test Stimulus
        </div>

        <div data-controller="hello">
            <input type="text">
            <button>Greet</button>
        </div>

        <section>
            {% for product in products %}

                <div>
                    <ul>
                        <li>
                            <a href="{{ path('app_product_details', { name: product.name }) }}">
                                <strong>{{ product.name|capitalize }}</strong>
                            </a>
                        </li>
                        <li>{{ product.description }}</li>
                        <li>{{ product.price }}€</li>
                    </ul>

                    {% for category in product.category %}

                        {{ category.name }}

                    {% endfor %}
                </div>

            {% endfor %}

        </section>


    </main>
{% endblock %}

