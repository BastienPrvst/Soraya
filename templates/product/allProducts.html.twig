{% extends 'base.html.twig' %}


{% block title %}
    Les produits
{% endblock %}

{% block body %}
    <main>

        {% for message in app.flashes('error') %}
            <div>{{ message }}</div>
        {% endfor %}

        <h1>Les Produits</h1>

        <section class="d-flex flex-row align-items-stretch flex-wrap w-100 mt-5 ">
            {% for product in products %}

                <div class="d-flex flex-column m-5 w-25 p-3 align-items-center bg-light mh-100 rounded-2">
                    <ul>
                        <li>
                            <a href="{{ path('app_product_details', { name: product.name }) }}">
                                <strong>{{ product.name|capitalize }}</strong>
                            </a>
                        </li>
                        <li>{{ product.description }}</li>
                        <li>{{ product.price }}€</li>
                    </ul>

                    <div>
                        <form action="{{ path('app_shopping_cart_add', {pageId : product.id}) }}" method="post">
                            <select name="quantity">
                                <option value="1">1</option>
                                <option value="2">2</option>
                                <option value="3">3</option>
                                <option value="4">4</option>
                                <option value="5">5</option>
                                <option value="6">6</option>
                            </select>
                            <input name="productId" type="hidden" value="{{ product.id }}">
                            <input class="bg-primary text-white rounded-2" type="submit" value="Ajouter au panier">
                        </form>
                    </div>

                    {% for category in product.category %}

                        {{ category.name }}

                    {% endfor %}
                </div>

            {% endfor %}

        </section>


    </main>
{% endblock %}

