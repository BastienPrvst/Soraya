<header class="fixed top-0 w-full bg-transparent z-50 transition-colors duration-300 text-white">

    <nav class="flex items-center justify-between px-[5%] py-4 relative">

        {# Bouton burger — visible uniquement sur mobile #}
        <button id="burger-btn"
                class="md:hidden relative z-50 text-2xl"
                aria-label="Ouvrir le menu"
                aria-expanded="false">

            <svg id="icon-burger"
                 xmlns="http://www.w3.org/2000/svg"
                 class="h-6 w-6"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="2">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 6h16M4 12h16M4 18h16" />
            </svg>

            <svg id="icon-close"
                 xmlns="http://www.w3.org/2000/svg"
                 class="h-6 w-6 hidden"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke="currentColor"
                 stroke-width="2">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        {# Nav classique — visible uniquement à partir de tablette (md) #}
        <ul class="hidden md:flex flex-row gap-8">
            <li><a href="{{ path('app_main') }}" class="hover:opacity-70 transition-opacity">Accueil</a></li>
            <li><a href="{{ path('app_products') }}" class="hover:opacity-70 transition-opacity">Produits</a></li>
            <li><a href="#" class="hover:opacity-70 transition-opacity">Contact</a></li>
        </ul>

        <img class="logo absolute left-1/2 -translate-x-1/2 h-8"
             src="{{ asset('images/site/logo-blanc.svg') }}"
             data-logo-dark="{{ asset('images/site/logo.svg') }}"
             data-logo-white="{{ asset('images/site/logo-blanc.svg') }}"
             alt="Logo de Lévédène">

        <div id="header-icons" class="flex items-center gap-4">

            {% if app.user %}
                <a href="{{ path('app_profile') }}" aria-label="Mon profil" class="hidden md:inline hover:opacity-70 transition-opacity">Mon profil</a>
                <a href="{{ path('app_logout') }}" aria-label="Se déconnecter" class="hidden md:inline hover:opacity-70 transition-opacity">Se déconnecter</a>
                <a href="{{ path('app_profile') }}" aria-label="Mon profil" class="md:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 0115 0" />
                    </svg>
                </a>
            {% else %}
                <a href="{{ path('app_register') }}" class="hidden md:inline hover:opacity-70 transition-opacity">S'inscrire</a>
                <a href="{{ path('app_login') }}" class="hidden md:inline hover:opacity-70 transition-opacity">Se connecter</a>
                <a href="{{ path('app_login') }}" aria-label="Se connecter" class="md:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 0115 0" />
                    </svg>
                </a>
            {% endif %}

            <a href="{{ path('app_shopping_cart_view') }}" class="relative flex items-center gap-1 hover:opacity-70 transition-opacity" aria-label="Mon panier">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a1.125 1.125 0 00-1.087-1.462H5.106M7.5 14.25L5.106 5.272M6.75 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                </svg>
                <span id="cart_quantity" class="absolute -top-2 -right-2 bg-[#453120] text-white text-xs rounded-full h-4 w-4 flex items-center justify-center md:static md:bg-transparent md:text-current md:rounded-none md:h-auto md:w-auto">
                    {{ totalQuantityCart }}
                </span>
                <span class="hidden md:inline">Mon panier</span>
            </a>
        </div>

    </nav>

    {# Menu plein écran mobile — arrive de la gauche #}
    <div id="mobile-menu"
         class="md:hidden fixed inset-0 bg-[#e2d3ba] text-[#453120] z-40 px-[5%] pt-20
                transform -translate-x-full transition-transform duration-300 ease-in-out invisible">
        <ul>
            <li class="border-b border-[#453120]">
                <a href="{{ path('app_main') }}" class="flex items-center justify-between py-4 text-lg">
                    Accueil
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>
            <li class="border-b border-[#453120]">
                <a href="{{ path('app_products') }}" class="flex items-center justify-between py-4 text-lg">
                    Produits
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>
            <li class="border-b border-[#453120]">
                <a href="#" class="flex items-center justify-between py-4 text-lg">
                    Contact
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>

            {% if app.user %}
                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_logout') }}" class="flex items-center justify-between py-4 text-lg">
                        Se déconnecter
                    </a>
                </li>
            {% else %}
                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_register') }}" class="flex items-center justify-between py-4 text-lg">
                        S'inscrire
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>

</header>

<script>
    const burgerBtn = document.getElementById('burger-btn');
    const iconBurger = document.getElementById('icon-burger');
    const iconClose = document.getElementById('icon-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const headerIcons = document.getElementById('header-icons');
    const header = document.querySelector('header');
    const logo = document.querySelector('.logo');

    // Fond du header au scroll
    window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
            logo.src = logo.dataset.logoDark;

            header.classList.add('header-bg', 'text-black');
            header.classList.remove('bg-transparent', 'text-white');
        } else {
            logo.src = logo.dataset.logoWhite;

            header.classList.add('bg-transparent', 'text-white');
            header.classList.remove('header-bg', 'text-black');
        }
    });

    burgerBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('translate-x-0');

        if (isOpen) {

            mobileMenu.classList.remove('translate-x-0');
            mobileMenu.classList.add('-translate-x-full');

            setTimeout(() => {
                mobileMenu.classList.add('invisible');
            }, 300);
        } else {

            mobileMenu.classList.remove('invisible');

            void mobileMenu.offsetWidth;

            mobileMenu.classList.remove('-translate-x-full');
            mobileMenu.classList.add('translate-x-0');
        }

        iconBurger.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');

        headerIcons.classList.toggle('hidden');

        burgerBtn.setAttribute('aria-expanded', String(!isOpen));
        burgerBtn.setAttribute(
            'aria-label',
            isOpen ? 'Ouvrir le menu' : 'Fermer le menu'
        );

        document.body.classList.toggle('overflow-hidden');
    });
</script>
