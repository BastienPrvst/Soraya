<header class="fixed top-0 w-full z-50 transition-colors duration-300"
        style="--header-bg: {{ header_bg|default('transparent') }};
            --header-text: {{ header_text|default('#ffffff') }};
            --header-bg-scrolled: {{ header_bg_scrolled|default('#ffffff') }};
            --header-text-scrolled: {{ header_text_scrolled|default('#000000') }};">

    <nav class="flex items-center justify-between px-[5%] py-4 relative
                bg-[var(--header-bg)] text-[var(--header-text)] transition-colors duration-300">

        {# Bouton burger #}
        <button id="burger-btn" class="xl:hidden relative z-50 text-2xl" aria-label="Ouvrir le menu" aria-expanded="false">
            <svg id="icon-burger" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <ul class="hidden xl:flex flex-row gap-8">
            <li><a href="{{ path('app_main') }}" class="hover:opacity-70 transition-opacity">Accueil</a></li>
            <li><a href="{{ path('app_products') }}" class="hover:opacity-70 transition-opacity">Produits</a></li>
            <li><a href="#" class="hidden xl:inline hover:opacity-70 transition-opacity">Contact</a></li>
        </ul>

        {# Logo #}
        <a href="{{ path('app_main') }}">
            <img id="logo"
                 class="logo absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-8 md:h-12 xl:h-14"
                 src="{{ header_logo|default('light') == 'dark' ? asset('images/site/logo.svg') : asset('images/site/logo-blanc.svg') }}"
                 data-logo-dark="{{ asset('images/site/logo.svg') }}"
                 data-logo-white="{{ asset('images/site/logo-blanc.svg') }}"
                 data-logo-default="{{ header_logo|default('light') }}"
                 data-logo-scrolled="{{ header_logo_scrolled|default('dark') }}"
                 alt="Logo de Lévédène">
        </a>

        <div id="header-icons" class="flex items-center gap-4">

            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="hidden xl:inline hover:opacity-70 transition-opacity">Mon profil</a>
                <a href="{{ path('app_logout') }}" class="hidden xl:inline hover:opacity-70 transition-opacity">Se déconnecter</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="hidden xl:inline hover:opacity-70 transition-opacity">Se connecter</a>
                <a href="{{ path('app_register') }}" class="hidden xl:inline hover:opacity-70 transition-opacity">S'inscrire</a>
            {% endif %}

            <a href="{{ path('app_shopping_cart_view') }}" class="relative flex items-center gap-1 hover:opacity-70 transition-opacity" aria-label="Mon panier">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a1.125 1.125 0 00-1.087-1.462H5.106M7.5 14.25L5.106 5.272M6.75 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                </svg>
                <span id="cart_quantity"
                      class="absolute -top-2 -right-2 bg-[#453120] text-white text-xs rounded-full h-4 w-4 flex items-center justify-center xl:static xl:bg-transparent xl:text-current xl:rounded-none xl:h-auto xl:w-auto">
                    {{ totalQuantityCart }}
                </span>
                <span class="hidden xl:inline">Mon panier</span>
            </a>
        </div>

    </nav>

    {# Menu plein écran mobile — arrive de la gauche #}
    <div id="mobile-menu"
         class="xl:hidden fixed inset-0 bg-[#e2d3ba] text-[#453120] z-40 px-[5%] pt-20
                transform -translate-x-full transition-transform duration-300 ease-in-out invisible">
        <ul>
            <li class="border-b border-[#453120]">
                <a href="{{ path('app_main') }}" class="flex items-center justify-between py-4 text-lg">
                    Accueil
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>
            <li class="border-b border-[#453120]">
                <a href="{{ path('app_products') }}" class="flex items-center justify-between py-4 text-lg">
                    Produits
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>
            <li class="border-b border-[#453120]">
                <a href="#" class="flex items-center justify-between py-4 text-lg">
                    Contact
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </li>

            {% if app.user %}
                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_profile') }}" class="flex items-center justify-between py-4 text-lg">
                        Mon profil
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </li>
                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_logout') }}" class="flex items-center justify-between py-4 text-lg">
                        Se déconnecter

                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </li>
            {% else %}
                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_register') }}" class="flex items-center justify-between py-4 text-lg">
                        S'inscrire

                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </li>

                <li class="border-b border-[#453120]">
                    <a href="{{ path('app_login') }}" class="flex items-center justify-between py-4 text-lg">
                        Se connecter

                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </li>
            {% endif %}
        </ul>
    </div>

</header>

<script>
    const burgerBtn   = document.getElementById('burger-btn');
    const iconBurger  = document.getElementById('icon-burger');
    const iconClose   = document.getElementById('icon-close');
    const mobileMenu  = document.getElementById('mobile-menu');
    const headerIcons = document.getElementById('header-icons');
    const header      = document.querySelector('header');
    const logo        = document.getElementById('logo');

    // Valeurs "au repos" lues une seule fois depuis les CSS vars injectées par Twig
    const restBg   = getComputedStyle(header).getPropertyValue('--header-bg').trim();
    const restText = getComputedStyle(header).getPropertyValue('--header-text').trim();
    const scrolledBg   = getComputedStyle(header).getPropertyValue('--header-bg-scrolled').trim();
    const scrolledText = getComputedStyle(header).getPropertyValue('--header-text-scrolled').trim();

    function updateLogo(isScrolled) {
        const variant = isScrolled
            ? logo.dataset.logoScrolled  // 'dark' ou 'light'
            : logo.dataset.logoDefault;  // 'dark' ou 'light'

        logo.src = variant === 'dark' ? logo.dataset.logoDark : logo.dataset.logoWhite;
    }

    function updateHeaderColors(isScrolled) {
        header.style.setProperty('--header-bg', isScrolled ? scrolledBg : restBg);
        header.style.setProperty('--header-text', isScrolled ? scrolledText : restText);
    }

    window.addEventListener('scroll', () => {
        const isScrolled = window.scrollY > 50;
        updateHeaderColors(isScrolled);
        updateLogo(isScrolled);
    });

    burgerBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('translate-x-0');

        if (isOpen) {

            mobileMenu.classList.remove('translate-x-0');
            mobileMenu.classList.add('-translate-x-full');

            setTimeout(() => {
                mobileMenu.classList.add('invisible');
            }, 300);
        } else {

            mobileMenu.classList.remove('invisible');

            void mobileMenu.offsetWidth;

            mobileMenu.classList.remove('-translate-x-full');
            mobileMenu.classList.add('translate-x-0');
        }

        iconBurger.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');

        headerIcons.classList.toggle('hidden');

        burgerBtn.setAttribute('aria-expanded', String(!isOpen));
        burgerBtn.setAttribute(
            'aria-label',
            isOpen ? 'Ouvrir le menu' : 'Fermer le menu'
        );

        document.body.classList.toggle('overflow-hidden');
    });
</script>
