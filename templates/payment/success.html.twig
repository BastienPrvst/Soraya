{% extends 'base.html.twig' %}

{% block title %}
    Commande confirmée
{% endblock %}

{% set header_text = 'var(--light)' %}
{% set header_bg = 'var(--dark)' %}
{% set header_bg_scrolled = 'var(--dark)' %}
{% set header_logo = 'light' %}
{% set footer_bg = 'var(--light)' %}
{% set footer_text = 'var(--dark)' %}

{% block body %}

    <main class="w-full h-full p-5 bg-[var(--dark)] flex justify-center min-h-[100vh] py-[10%] md:py-[5%]">
{#        <h1 class="text-center">Votre commande #{{ "%05d"|format(order.id) }} est confirmée !</h1>#}

        <section class="p-5 text-center bg-[#837261] py-[20%] md:py-[10%] px-[10%] w-[95%] flex items-center justify-center">
            <div class="flex flex-col items-center justify-cebter">
                <h1 class="text-center text-white text-5xl md:text-6xl mb-15">Merci pour votre commande ! Nous préparons votre colis avec le plus grand soin.</h1>

                <button class="border-1 border-white rounded-lg px-6 py-3"><a class="text-2xl text-white" href="{{ path('app_main') }}">Retour à l'accueil</a></button>
            </div>

        </section>
    </main>



{% endblock %}
