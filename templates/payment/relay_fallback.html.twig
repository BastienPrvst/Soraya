{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}


{% block body %}
    <main class="container-fluid d-flex flex-row">
        <div class="row w-100">
            <section class="left ms-3 col-7">
                <div class="h-75">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}


                    <h2>1. Choix du mode de livraison</h2>
                    <hr>

                    <a href="{{ path('checkout_delivery_home', { token: order.token }) }}" data-turbo-frame="delivery_infos">
                        A domicile
                    </a>

                    <a href="{{ path('checkout_delivery_relay', { token : order.token }) }}" data-turbo-frame="delivery_infos">En point relais</a>

                </div>
            </section>





            <section id="order_details" class="col-4 ms-3">
                <div>
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">
                {% include 'payment/relay.frame.html.twig' %}
            </section>

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key={{ google_api_key }}"></script>
    <script src="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.js"></script>

    <script>
        $(document).ready(function() {
            // Loading the Parcelshop picker widget into the <div> with id "Zone_Widget" with such settings:
            $("#Zone_Widget").MR_ParcelShopPicker({
                Target: "#Target_Widget",
                Brand: "BDTEST",
                Country: "FR",
                PostCode: "75001",
                ColLivMod: "24R",
                NbResults: "7",
                Responsive: true,
                ShowResultsOnMap: true,
                EnableGmap: true
            });

        });
    </script>
{% endblock %}

