{% extends 'base.html.twig' %}

{% block title %}
    Connectez vous ou continuez en mode invité
{% endblock %}

{% block body %}

    <div class="flex flex-row">

        <form method="post" class="w-1/2 p-3" action="{{ path('app_login') }}">
            Continuer en se connectant :
            {% if error %}
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <h1 class="text-2xl mb-3 font-normal">Se connecter</h1>
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="block w-full px-3 py-2 border border-gray-300 rounded-md mb-3" autocomplete="email" required autofocus>
            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" class="block w-full px-3 py-2 border border-gray-300 rounded-md mb-3" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="px-4 py-2 text-lg bg-blue-600 text-white rounded-md hover:bg-blue-700" type="submit">
                Se connecter
            </button>
        </form>


        <div class="w-1/2 flex items-center justify-center">
            <a class="m-5" href="{{ path('checkout_delivery', {token: order.token}) }}">Continuer en tant qu'invité</a>
            <br>
            <a href="{{ path('app_register') }}">S'inscrire</a>
        </div>

    </div>

{% endblock %}
