{% extends 'base.html.twig' %}

{% block title %}
    Connectez vous ou continuez en mode invité
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="relative flex flex-col md:flex-row md:min-h-screen">
        <div class="bg-[var(--dark)] w-full md:w-1/2 py-16 px-[40px] md:py-24 flex justify-center">
            <form method="post" action="{{ path('app_login') }}" class="pt-[10%] form-dark w-full md:w-[80%]">

                <svg class="self-center pb-4 hidden md:block" width="89" height="89" viewBox="0 0 89 89" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_311_1319)">
                        <path d="M36.9879 46.0481C35.7263 45.1879 34.5412 44.2895 33.6045 43.1234C29.9535 38.727 28.8831 33.7762 30.7946 28.3857C32.687 23.0526 36.5482 19.7457 42.0916 18.6752C50.4258 17.0695 58.3777 22.6703 59.6011 31.0236C60.4804 37.0831 58.263 41.9765 53.3313 45.6084C53.1402 45.7422 52.7961 45.8187 52.8152 46.0481C52.8343 46.3539 53.2166 46.3157 53.446 46.4112C62.0287 50.0814 67.0942 56.4849 68.4514 65.7557C68.5852 66.635 68.5661 67.5143 68.5852 68.3936C68.6043 69.5405 67.897 70.2669 66.8648 70.2669C65.8517 70.2478 65.2018 69.5597 65.1827 68.4319C65.068 63.806 63.6917 59.6007 60.7671 55.9688C57.1352 51.4576 52.4138 48.8771 46.6028 48.3419C36.1851 47.3861 26.7613 54.6881 24.9071 64.8956C24.6969 66.0234 24.6013 67.1703 24.5631 68.3172C24.5248 69.5405 23.894 70.2669 22.8427 70.2669C21.7723 70.2478 21.1415 69.5214 21.1606 68.2981C21.2179 58.664 27.2583 49.9093 36.2615 46.4304C36.4718 46.373 36.7394 46.3539 36.9879 46.0481ZM44.8442 44.7865C51.2478 44.7865 56.2942 39.721 56.2942 33.3174C56.2942 26.9712 51.2095 21.8866 44.8824 21.8866C38.498 21.8866 33.4134 26.9521 33.3943 33.3365C33.3943 39.721 38.4406 44.7865 44.8442 44.7865Z" fill="var(--light)"/>
                        <path d="M44.5 89C32.6104 89 21.4472 84.3741 13.0365 75.9635C4.62586 67.5528 0 56.3896 0 44.5C0 32.6104 4.62586 21.428 13.0365 13.0365C21.428 4.62586 32.6104 0 44.5 0C56.3896 0 67.5528 4.62586 75.9635 13.0365C84.3741 21.4472 89 32.6104 89 44.5C89 56.3896 84.3741 67.5528 75.9635 75.9635C67.5528 84.355 56.3896 89 44.5 89ZM44.5 3.44072C33.5279 3.44072 23.2249 7.70339 15.4641 15.4641C7.70339 23.2249 3.44072 33.5279 3.44072 44.5C3.44072 55.4721 7.70339 65.7751 15.4641 73.5359C23.2249 81.2966 33.5279 85.5593 44.5 85.5593C55.4721 85.5593 65.7751 81.2966 73.5359 73.5359C81.2966 65.7751 85.5593 55.4721 85.5593 44.5C85.5593 33.5279 81.2966 23.2249 73.5359 15.4641C65.7751 7.70339 55.453 3.44072 44.5 3.44072Z" fill="var(--light)"/>
                    </g>
                    <defs>
                        <clipPath id="clip0_311_1319">
                            <rect width="89" height="89" fill="var(--light)"/>
                        </clipPath>
                    </defs>
                </svg>

                <h1 class="mb-3 font-weight-normal text-3xl text-center">Se connecter</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}
                <label for="username">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">


                <div>
                    <div class="flex flex-col md:flex-row justify-between">
                        <a href="{{ path('app_password_forgot') }}">Mot de passe oublié ?</a>
                    </div>


                </div>

                <button class="btn btn-lg btn-primary" type="submit">
                    Se connecter
                </button>

            </form>
        </div>

        <div class="relative h-0 md:hidden z-10">
            <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-[var(--light)] flex items-center justify-center text-[var(--dark)] uppercase text-sm font-bold">
                Ou
            </div>
        </div>

        <div class="hidden md:flex absolute z-10 left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-[var(--light)] items-center justify-center text-[var(--dark)] uppercase text-sm font-bold">
            Ou
        </div>



        <div class="w-full md:w-1/2 bg-[var(--light)] flex items-center justify-center py-16">
            <h2 class="text-center text-3xl underline text-[var(--dark)]">
                <a class="block px-5" href="{{ path('checkout_delivery', {token: order.token}) }}">
                    Continuer en tant qu'invité
                </a>
            </h2>
        </div>


    </main>



{% endblock %}
