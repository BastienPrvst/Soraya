{% extends 'base.html.twig' %}

{% block title %}
    Paiement
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="w-full min-h-screen flex flex-col pt-[100px] px-[5%] pb-[5%] bg-[var(--light)]">

        <a class="block md:inline underline text-[var(--dark)]" href="{{ path('checkout_summary', { token:order.token }) }}">Retour</a>

        <section class="w-full h-full flex-1 flex flex-col items-center ">
            <h1 class="text-3xl text-center py-6">Paiement</h1>

            <div id="checkout" class="w-[100%] max-w-[1000px] flex-1 border border-[#b8a98c] rounded-xl bg-[#F0EBDE] flex items-center justify-center p-8">
            </div>
        </section>

    </main>


{% endblock %}

{% block javascripts %}
    <script src="https://js.stripe.com/clover/stripe.js"></script>
    <script src="{{ asset('js/checkout.js') }}" defer></script>
    <script>
        const checkoutPageUrl = '{{ url('checkout_stripe', { token:order.token }) }}';
        const stripePublicKey = '{{ stripe_public_key }}'
    </script>
{% endblock %}
