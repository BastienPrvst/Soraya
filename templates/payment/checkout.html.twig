{% extends 'base.html.twig' %}

{% block title %}
    Paiement
{% endblock %}

{% block body %}

    <main class="w-full px-4 flex flex-row">
        <div class="flex flex-wrap w-full">
            <section class="flex flex-row">
                <div class="left ml-3 w-7/12">
                    <h2>Paiement</h2>
                    <div>
                        <h3>Résumé</h3>

                        <br>

                        <a href="{{ path('checkout_summary', { token:order.token }) }}">Retour</a>


                        <div class="user-info flex items-center justify-center flex-col">

                            <div>
                                <span>{{ order.firstname }} {{ order.lastname }}</span><br>
                                <span>{{ order.email }}</span><br>
                                {% if order.phoneNumber %}
                                    <span>{{ order.phoneNumber }}</span>
                                {% endif %}
                                {% set countries = {
                                    'FR': 'France',
                                    'BE': 'Belgique',
                                    'LU': 'Luxembourg',
                                    'MO': 'Monaco'
                                } %}

                                <span>{{ order.activeAddress.street1 }}</span>
                                {% if order.activeAddress.street2 %}
                                    <br>
                                    <span>{{ order.activeAddress.street2 }}</span>
                                {% endif %}
                                <br>
                                <span>{{ order.activeAddress.zipcode }} {{ order.activeAddress.city }}</span>
                                <br>
                                <span>{{ countries[order.activeAddress.country] }}</span>

                            </div>
                        </div>


                    </div>
                </div>

                <hr>

                <div class="w-5/12">
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section class="mt-5">
                <h2>Paiement</h2>

                <div id="checkout" class="w-full">
                </div>
            </section>


        </div>

    </main>

{% endblock %}

{% block javascripts %}
    <script src="https://js.stripe.com/clover/stripe.js"></script>
    <script src="{{ asset('js/checkout.js') }}" defer></script>
    <script>
        const checkoutPageUrl = '{{ url('checkout_stripe', { token:order.token }) }}';
        const stripePublicKey = '{{ stripe_public_key }}'
    </script>
{% endblock %}
