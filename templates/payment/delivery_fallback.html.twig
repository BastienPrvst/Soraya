{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}


{% block body %}
    <main class="container-fluid d-flex flex-row">
        <div class="row w-100">
            <section class="left ms-3 col-7">
                <div class="h-75">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}


                    <h2>1. Choix du mode de livraison</h2>
                    <hr>

                    <a href="{{ path('checkout_delivery_home', { token: order.token }) }}" data-turbo-frame="delivery_infos">
                        A domicile
                    </a>

                    <a href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}" data-turbo-frame="delivery_infos">
                        En point relais
                    </a>

                </div>
            </section>

            <section id="order_details" class="col-4 ms-3">
                <div>
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">
                {% include 'payment/delivery.frame.html.twig' %}
            </section>

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_api_key }}"></script>
    <script src="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.js"></script>

    <script>

        function initRelayWidget(container) {

            const zone = container.querySelector("#Zone_Widget");
            const target = container.querySelector("#Target_Widget");

            if (!zone || !target) return;

            if (zone.dataset.initialized === "true") return;

            $(zone).MR_ParcelShopPicker({
                Target: "#Target_Widget",
                Brand: "BDTEST",
                Country: "FR",
                AllowedCountries: "FR,BE,LU,ES",
                PostCode: "75001",
                ColLivMod: "24R",
                NbResults: "10",
                Responsive: true,
                ShowResultsOnMap: true,
                EnableGmap: true
            });

            zone.dataset.initialized = "true";
        }


        /* Chargement classique (refresh page) */
        document.addEventListener("DOMContentLoaded", function () {

            const frame = document.getElementById("delivery_infos");

            if (!frame) return;

            initRelayWidget(frame);

        });


        /* Chargement via Turbo */
        document.addEventListener("turbo:frame-load", function (event) {

            if (event.target.id !== "delivery_infos") return;

            initRelayWidget(event.target);

        });
    </script>
{% endblock %}



