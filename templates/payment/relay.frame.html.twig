<turbo-frame id="delivery_infos">

    <div class="w-100">

        {% for message in app.flashes('error') %}
            <div class="text-danger">
                {{ message }}
            </div>

        {% endfor %}

        {{ form_start(form, {
            action: path('checkout_delivery', { token: order.token }),
            method: 'POST',
            attr: {
                'data-turbo': 'false'
            }
        }) }}

        <div>
            {{ form_row(form.relay_id, {'id': 'Target_Widget'}) }}
        </div>
        <div>
            {{ form_row(form.firstname) }}
        </div>

        <div>
            {{ form_row(form.lastname) }}
        </div>

        <div>
            {{ form_row(form.email) }}
        </div>

        <div>
            {{ form_row(form.phoneNumber) }}
        </div>

        {% if order.relayId is null %}
            <div id="Zone_Widget"></div>
        {% else %}

            <div id="relay_info" class="bg-light p-2 mb-3 rounded-2">

                <p>{{ order.deliveryAddress.street1 }}
                    <br>
                    {% if order.deliveryAddress.street2 %}
                        {{ order.deliveryAddress.street2 }}
                        <br>
                    {% endif %}
                    {{ order.deliveryAddress.city }} {{ order.deliveryAddress.zipcode }}
                    <br>
                    {{ order.deliveryAddress.country }}
                </p>

                <button class="btn-primary btn">Modifier</button>

            </div>

        {% endif %}



        {{ form_row(form.submit_relay) }}
        {{ form_end(form) }}


    </div>
</turbo-frame>
