{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}


{% block body %}
    <main class="w-[100%] flex flex-col">

        <section class="pt-[20%] w-[100%] bg-[var(--light)] px-[var(--padX)]">
            <div>

                <a
                    class="block underline text-[var(--dark)] my-5"
                    href="{{ path('checkout_previous', { token:order.token }) }}"
                >
                    Retour
                </a>


                <h1 class="text-3xl text-center text-[var(--dark)]">Choix du mode de livraison</h1>

                <div class="w-full py-5 flex">
                    <a class="w-1/2 text-xl text-center text-[var(--dark)] bg-[var(--dark)] rounded-xl text-white py-2 cursor-pointer" href="{{ path('checkout_delivery_home', { token: order.token }) }}">
                        A domicile
                    </a>

                    <a class="w-1/2 text-xl text-center text-[var(--dark)] py-2 cursor-pointer" href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}">
                        En point relais
                    </a>
                </div>



            </div>
        </section>

        <section id="delivery-content" class=" bg-[var(--light)] px-[var(--padX)]">
            <div class="w-[100%] mx-auto flex flex-col items-center">
                {{ form_start(form, {
                    attr: {
                        class : 'form-light pb-10'
                    }
                }) }}

                <div>
                    {{ form_row(form.firstname) }}
                </div>

                <div>
                    {{ form_row(form.lastname) }}
                </div>

                <div>
                    {{ form_row(form.email) }}
                </div>

                <div>
                    {{ form_row(form.phoneNumber) }}
                </div>

                <div>
                    {{ form_row(form.deliveryAddress.street1) }}
                </div>

                <div class="street_wrapper">
                    {{ form_row(form.deliveryAddress.street2) }}
                </div>

                <div>
                    {{ form_row(form.deliveryAddress.city) }}
                </div>

                <div>
                    {{ form_row(form.deliveryAddress.zipcode) }}
                </div>

                <div>
                    {{ form_row(form.deliveryAddress.country) }}
                </div>

                <div>
                    {{ form_row(form.CGU, {
                        attr: {
                        class : 'text-center'
                    }
                    }) }}
                </div>

                {{ form_end(form) }}
            </div>
        </section>

        <section id="order_details" class="w-[100%] px-[var(--padX)] bg-[var(--dark)] text-white">

            <h2>Votre commande :</h2>
            <div>
                Total produit (TVA incluse) {{ order.total }}€
                <br>
                <span>
                Total {{ order.total + order.deliveryPrice }} €
            </span>
            </div>
        </section>

    </main>

{% endblock %}

{% block javascripts %}
    {{ parent()}}
    <script src="{{ asset('js/delivery.js') }}" defer></script>
{% endblock %}
