{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}


{% block body %}
    <main class="w-full px-4 flex flex-row">
        <div class="flex flex-wrap w-full">
            <section class="ml-3 w-7/12">
                <div class="h-3/4">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}


                    <h2>1. Choix du mode de livraison</h2>
                    <hr>

                    <a href="{{ path('checkout_delivery_home', { token: order.token }) }}">
                        A domicile
                    </a>

                    <a href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}">
                        En point relais
                    </a>

                </div>
            </section>

            <section id="order_details" class="w-1/3 ml-3">
                <div>
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">
                <div class="w-1/2 mx-auto">
                    {{ form_start(form) }}

                    <div>
                        {{ form_row(form.firstname) }}
                    </div>

                    <div>
                        {{ form_row(form.lastname) }}
                    </div>

                    <div>
                        {{ form_row(form.email) }}
                    </div>

                    <div>
                        {{ form_row(form.phoneNumber) }}
                    </div>

                    <div>
                        {{ form_row(form.deliveryAddress.street1) }}
                    </div>

                    <div class="street_wrapper">
                        {{ form_row(form.deliveryAddress.street2) }}
                    </div>

                    <div>
                        {{ form_row(form.deliveryAddress.city) }}
                    </div>

                    <div>
                        {{ form_row(form.deliveryAddress.zipcode) }}
                    </div>

                    <div>
                        {{ form_row(form.deliveryAddress.country) }}
                    </div>

                    <div>
                        {{ form_row(form.CGU) }}
                    </div>

                    {{ form_end(form) }}
                </div>
            </section>

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    {{ parent()}}
    <script src="{{ asset('js/delivery.js') }}" defer></script>
{% endblock %}
