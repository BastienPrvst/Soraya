{% extends 'base.html.twig' %}

{% block title %}
    Paiement
{% endblock %}

{% block body %}

    <main class="container-fluid d-flex flex-row">
        <div class="row w-100">
            <section class="d-flex flex-row">
                <div class="left ms-3 col-7">
                    <h2>Résumé de votre commande</h2>
                    <div>
                        <br>

                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>


                        <div class="user-info d-flex align-items-center justify-content-center flex-column">

                            <div>
                                <span>{{ order.firstname }} {{ order.lastname }}</span><br>
                                <span>{{ order.email }}</span><br>
                                {% if order.phoneNumber %}
                                    <span>{{ order.phoneNumber }}</span>
                                {% endif %}
                                {% set countries = {
                                    'FR': 'France',
                                    'BE': 'Belgique',
                                    'LU': 'Luxembourg',
                                    'MO': 'Monaco'
                                } %}

                                <span>{{ order.activeAddress.street1 }}</span>
                                {% if order.activeAddress.street2 %}
                                    <br>
                                    <span>{{ order.activeAddress.street2 }}</span>
                                {% endif %}
                                <br>
                                <span>{{ order.activeAddress.zipcode }} {{ order.activeAddress.city }}</span>
                                <br>
                                <span>{{ countries[order.activeAddress.country] }}</span>
                                <br>
                                <span>Livraison : {{ order.deliveryMode.value == 'relay' ? 'Point relais' : ' Domicile'}}</span>

                            </div>
                        </div>
                    </div>
                </div>

                <hr>

                <div class="col-5">
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>

            <section class="w-100">
                <a class="btn btn-primary" href="{{ path('checkout_pay', { token: order.token }) }}">Procéder au paiement</a>
            </section>
        </div>

    </main>

{% endblock %}

{% block javascripts %}
{% endblock %}




