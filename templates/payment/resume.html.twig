{% extends 'base.html.twig' %}

{% block title %}
    Résumé de votre commande
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="w-[100%] flex flex-col md:flex-row">

        <section class="pt-[100px] w-[100%] md:w-[65%] lg:w-[75%] bg-[var(--light)] px-[var(--padX)] flex flex-col box-border">
            <div>

                <a class="block md:inline underline text-[var(--dark)] my-5"
                   href="{{ path('checkout_previous', { token:order.token }) }}">
                    Retour
                </a>


                <h1 class="text-3xl text-center text-[var(--dark)] py-5">Résumé de votre commande</h1>
            </div>

            <div class="w-[100%] mx-auto flex flex-col items-center pb-15 min-h-[70vh]">
                    <div class="w-[100%] bg-[#F2EDE0] border border-[#b8a98c] mb-3 rounded-lg p-5 font-medium md:text-lg w-[100%] max-w-[1000px]">

                        <h2 class="pt-5 text-xl">Destinataire :</h2>
                        <hr>

                        <div class="flex justify-between pt-3">
                            <span>{{ order.firstname }} {{ order.lastname }}</span>
                        </div>

                        <h2 class="pt-5 text-xl">Coordonnées</h2>
                        <hr>

                        <div class="flex justify-between pt-3">
                            <span>Email :</span>
                            <span>{{ order.email }}</span>
                        </div>

                        <div class="flex justify-between">
                            <span>Téléphone :</span>
                            <span>{{ order.phoneNumber }}</span>
                        </div>

                        <h2 class="pt-5 text-xl">Type de livraison</h2>
                        <hr>
                        <span class="block pt-3">{{ order.deliveryMode.value == 'relay' ? 'Point relais' : ' Domicile'}}</span>

                        <h2 class="pt-5 text-xl">Adresse de livraison</h2>
                        <hr>

                        <div class="flex justify-between pt-3">
                            <span class="w-1/3">Rue :</span>
                            <span>{{ order.activeAddress.street1 }}</span>
                        </div>

                        {% if order.activeAddress.street2 %}
                            <div class="flex justify-between">
                                <span>Complément de rue</span>
                                <span>{{ order.activeAddress.street2 }}</span>
                            </div>

                        {% endif %}

                        <div class="flex justify-between">
                            <span>Code postal :</span>
                            <span>{{ order.activeAddress.zipcode }}</span>
                        </div>

                        <div class="flex justify-between">
                            <span>Ville :</span>
                            <span> {{ order.activeAddress.city }}</span>
                        </div>

                        <div class="flex justify-between">
                            <span>Pays :</span>
                            <span>{{ order.activeAddress.fullCountry }}</span>
                        </div>

                        <h2 class="pt-5 text-xl">Total</h2>
                        <hr>
                        <div class="flex justify-between pt-3">
                            <span>Produits :</span>
                            <span>{{ order.total }} €</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Livraison :</span>
                            <span>
                                {% if order.deliveryPrice == 0 %}
                                    Offerte
                                {% else %}
                                    {{ order.deliveryPrice }} €
                                {% endif %}</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Total :</span>
                            <span>{{ order.orderTotal }} €</span>
                        </div>



                    </div>

                <a class="cursor-pointer p-4 my-8 py-2 bg-[var(--dark)] text-white rounded-md hover:bg-[var(--light)] change_relay" href="{{ path('checkout_pay', { token: order.token }) }}">Procéder au paiement</a>
            </div>
        </section>

        <section id="order_details" class="w-[100%] md:w-[35%] lg:w-[25%] md:pt-[120px] px-[var(--padX)] pt-12 pb-20 bg-[var(--dark)] text-white box-border">

            <h2 class="text-3xl">Votre commande :</h2>

            <span class="text-xl block py-7">Produits :</span>

            {% for orderItem in order.orderItems %}
                {% set product = orderItem.product %}
                <div>
                    <div class="flex border-b border-[var(--light)] py-4">
                        <div class="w-[35%] max-w-[130px] shrink-0 md:max-w-[200px]">
                            {% if product.mainImage is not null %}
                                <img src="{{ vich_uploader_asset(product.mainImage, 'imageFile') }}"
                                     alt="{{ product.name }} - image"
                                     class="block w-full aspect-[3/4] object-cover">
                            {% else %}
                                <img src="{{ asset('images/site/placeholder.jpg') }}" alt=""
                                     class="block w-full aspect-[3/4] object-cover">
                            {% endif %}
                        </div>

                        <p class="px-3 break-words min-w-0">{{ product.name }}</p>

                    </div>
                    <div>
                        <div class="flex justify-between py-2 text-l">
                            <p>Quantité : {{ orderItem.quantity }}</p>
                            <p>{{ orderItem.total }} €</p>
                        </div>

                    </div>
                </div>


            {% endfor %}

            <div class="flex justify-between py-2">
                <p>Livraison</p>
                <p>{% if order.deliveryPrice == 0 %}
                        Offerte
                    {% else %}
                        {{ order.deliveryPrice }}€
                    {% endif %}
                </p>
            </div>

            <div class="flex justify-between py-2">
                <p>Total :</p>
                <p>{{ order.orderTotal }} €</p>
            </div>

        </section>
    </main>


{% endblock %}

{% block javascripts %}
{% endblock %}
