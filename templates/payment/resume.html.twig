{% extends 'base.html.twig' %}

{% block title %}
    Paiement
{% endblock %}

{% block body %}

    <main class="w-full px-4 flex flex-row">
        <div class="flex flex-wrap w-full">
            <section class="flex flex-row">
                <div class="left ml-3 w-7/12">
                    <h2>Résumé de votre commande</h2>
                    <div>
                        <br>

                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>


                        <div class="user-info flex flex-row items-center justify-center flex-col">

                            <div>
                                <h3>Adresse de livraison</h3>
                                <span>{{ order.firstname }} {{ order.lastname }}</span><br>
                                <span>{{ order.email }}</span><br>
                                {% if order.phoneNumber %}
                                    <span>{{ order.phoneNumber }}</span>
                                {% endif %}


                                <span>{{ order.activeAddress.street1 }}</span>
                                {% if order.activeAddress.street2 %}
                                    <br>
                                    <span>{{ order.activeAddress.street2 }}</span>
                                {% endif %}
                                <br>
                                <span>{{ order.activeAddress.zipcode }} {{ order.activeAddress.city }}</span>
                                <br>
                                <span>{{ order.activeAddress.fullCountry }}</span>
                                <br>
                                <span>Livraison : {{ order.deliveryMode.value == 'relay' ? 'Point relais' : ' Domicile'}}</span>
                                <br>
                                <a href="{{ path('checkout_previous', { token:order.token }) }}">Modifier</a>

                            </div>

                        </div>
                    </div>
                </div>

                <hr>

                <div class="w-5/12">
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>

            <section class="w-full">
                <a class="inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" href="{{ path('checkout_pay', { token: order.token }) }}">Procéder au paiement</a>
            </section>
        </div>

    </main>

{% endblock %}

{% block javascripts %}
{% endblock %}
