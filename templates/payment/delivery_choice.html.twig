{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}


{% block body %}
    <main class="w-full px-4 flex flex-row">
        <div class="flex flex-wrap w-full">
            <section class="left ml-3 w-7/12">
                <div class="h-3/4">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}

                    <div>
                        <h2>Choix du mode de livraison</h2>
                        <hr>

                        <a href="{{ path('checkout_delivery_home', { token: order.token }) }}" class="mx-3 no-underline">
                            A domicile
                        </a>

                        <a href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}" class="mx-3 no-underline">
                            En point relais
                        </a>
                    </div>

                    {% set mode = order.deliveryMode is not null ? order.deliveryMode.value : 'home' %}

                </div>
            </section>

            <section id="order_details" class="w-1/3 ml-3">
                <div class="flex items-start justify-center flex-col">
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">

            </section>

        </div>
    </main>

{% endblock %}
