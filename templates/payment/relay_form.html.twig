{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}

{% block body_attributes %}
    data-turbo="false"
{% endblock %}

{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}


{% block body %}
    <main class="w-[100%] flex flex-col md:flex-row">

        <section class="pt-[100px] w-[100%] md:w-[65%] lg:w-[75%] bg-[var(--light)] px-[var(--padX)] flex flex-col box-border">
            <div>

                <a class="block md:inline underline text-[var(--dark)] my-5"
                    href="{{ path('checkout_previous', { token:order.token }) }}">
                    Retour
                </a>


                <h1 class="text-3xl text-center text-[var(--dark)]">Choix du mode de livraison</h1>

                <div class="w-full md:w-[75%] lg:w-[50%] md:mx-auto py-5 flex">
                    <a class="w-1/2 text-xl text-center text-[var(--dark)] py-2 cursor-pointer mr-1" href="{{ path('checkout_delivery_home', { token: order.token }) }} ">
                        A domicile
                    </a>

                    <a class="w-1/2 text-xl text-center bg-[var(--dark)] rounded-xl text-white py-2 cursor-pointer ml-1" href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}" data-turbo="false">
                        En point relais
                    </a>
                </div>
            </div>

            <div id="delivery-content">
                <div class="w-[100%] mx-auto flex flex-col items-center">

                    {% for message in app.flashes('error') %}
                        <div class="text-red-600">
                            {{ message }}
                        </div>

                    {% endfor %}

                    {{ form_start(form, {
                        attr: {
                            'class' : 'form-light pb-10 w-full'
                        }
                    }) }}

                    {{ form_widget(form.relay_id, {'id': 'Target_Widget'}) }}

                    {{ form_row(form.firstname) }}


                    {{ form_row(form.lastname) }}

                    {{ form_row(form.email) }}

                    {{ form_row(form.phoneNumber) }}


                    {% if order.relayId is null or order.relayAddress is null %}
                        <div id="Zone_Widget"></div>
                    {% else %}

                        <div id="relay_info" class="bg-[#F2EDE0] border border-[#b8a98c] p-2 mb-3 rounded-lg font-semibold">

                            <p class="p-4">{{ order.relayAddress.street1 }}
                                <br>
                                {% if order.relayAddress.street2 %}
                                    {{ order.relayAddress.street2 }}
                                    <br>
                                {% endif %}
                                {{ order.relayAddress.city }} {{ order.relayAddress.zipcode }}
                                <br>
                                {{ order.relayAddress.country }}
                            </p>

                            <button type="button" class="cursor-pointer p-4 ml-4 mb-4 py-2 bg-[var(--dark)] text-white rounded-md hover:bg-[var(--light)] change_relay">Modifier</button>

                        </div>

                        <div id="Zone_Widget" class="hidden"></div>

                    {% endif %}

                    {{ form_errors(form.relay_id) }}

                    {{ form_row(form.CGU) }}

                    {{ form_row(form.submit_relay) }}
                    {{ form_end(form) }}


                </div>
            </div>

        </section>

        <section id="order_details" class="w-[100%] md:w-[35%] lg:w-[25%] md:pt-[120px] px-[var(--padX)] pt-12 pb-20 bg-[var(--dark)] text-white box-border">

            <h2 class="text-3xl">Votre commande :</h2>

            <span class="text-xl block py-7">Produits :</span>

            {% for orderItem in order.orderItems %}
                {% set product = orderItem.product %}
                <div>
                    <div class="flex border-b border-[var(--light)] py-4">
                        <div class="w-[35%] max-w-[130px] shrink-0 md:max-w-[200px]">
                            {% if product.mainImage is not null %}
                                <img src="{{ vich_uploader_asset(product.mainImage, 'imageFile') }}"
                                     alt="{{ product.name }} - image"
                                     class="block w-full aspect-[3/4] object-cover">
                            {% else %}
                                <img src="{{ asset('images/site/placeholder.jpg') }}" alt=""
                                     class="block w-full aspect-[3/4] object-cover">
                            {% endif %}
                        </div>

                        <p class="px-3 break-words min-w-0">{{ product.name }}</p>

                    </div>
                    <div>
                        <div class="flex justify-between py-2 text-l">
                            <p>Quantité : {{ orderItem.quantity }}</p>
                            <p>{{ orderItem.total }} €</p>
                        </div>

                    </div>
                </div>


            {% endfor %}

            <div class="flex justify-between py-2">
                <p>Livraison</p>
                <p>{% if order.deliveryPrice == 0 %}
                        Offerte
                    {% else %}
                        {{ order.deliveryPrice }}€
                    {% endif %}
                </p>
            </div>

            <div class="flex justify-between py-2">
                <p>Total :</p>
                <p>{{ order.orderTotal }} €</p>
            </div>

        </section>
    </main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('mondial_relay') }}
    {{ importmap('relay') }}
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_api_key }}"></script>
{% endblock %}
