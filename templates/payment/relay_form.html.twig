{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}


{% block body %}
    <main class="container-fluid d-flex flex-row">
        <div class="row w-100">
            <section class="left ms-3 col-7">
                <div class="h-75">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}


                    <h2>1. Choix du mode de livraison</h2>
                    <hr>

                    <a href="{{ path('checkout_delivery_home', { token: order.token }) }}">
                        A domicile
                    </a>

                    <a href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}">
                        En point relais
                    </a>

                </div>
            </section>

            <section id="order_details" class="col-4 ms-3">
                <div>
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">
                <div class="w-100">

                    {% for message in app.flashes('error') %}
                        <div class="text-danger">
                            {{ message }}
                        </div>

                    {% endfor %}

                    {{ form_start(form) }}

                    <div>
                        {{ form_widget(form.relay_id, {'id': 'Target_Widget'}) }}
                    </div>
                    <div>
                        {{ form_row(form.firstname) }}
                    </div>

                    <div>
                        {{ form_row(form.lastname) }}
                    </div>

                    <div>
                        {{ form_row(form.email) }}
                    </div>

                    <div>
                        {{ form_row(form.phoneNumber) }}
                    </div>

                    {% if order.relayId is null or order.relayAddress is null %}
                        <div id="Zone_Widget"></div>
                    {% else %}

                        <div id="relay_info" class="bg-light p-2 mb-3 rounded-2">

                            <p>{{ order.relayAddress.street1 }}
                                <br>
                                {% if order.relayAddress.street2 %}
                                    {{ order.relayAddress.street2 }}
                                    <br>
                                {% endif %}
                                {{ order.relayAddress.city }} {{ order.relayAddress.zipcode }}
                                <br>
                                {{ order.relayAddress.country }}
                            </p>

                            <button class="btn-primary btn change_relay">Modifier</button>

                        </div>

                        <div id="Zone_Widget" class="d-none"></div>

                    {% endif %}

                    {{ form_errors(form.relay_id) }}

                    {{ form_row(form.CGU) }}

                    {{ form_row(form.submit_relay) }}
                    {{ form_end(form) }}


                </div>
            </section>

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js" data-turbo-eval="false"></script>
    <script type="text/javascript" src="//unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_api_key }}"></script>
    <script src="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.js" data-turbo-eval="false"></script>

    <script src="{{ asset('js/relay.js') }}"></script>
{% endblock %}



