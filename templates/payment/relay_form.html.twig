{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css">
    <link rel="stylesheet" href="https://widget.mondialrelay.com/parcelshop-picker/jquery.plugin.mondialrelay.parcelshoppicker.min.css">
{% endblock %}

{% block title %}
    Votre Commande
{% endblock %}

{% block body_attributes %}
    data-turbo="false"
{% endblock %}


{% block body %}
    <main class="w-full px-4 flex flex-row">
        <div class="flex flex-wrap w-full">
            <section class="left ml-3 w-7/12">
                <div class="h-3/4">

                    {% if app.user is null %}
                        <a href="{{ path('checkout_previous', { token:order.token }) }}">Retour</a>
                    {% endif %}


                    <h2>1. Choix du mode de livraison</h2>
                    <hr>

                    <a href="{{ path('checkout_delivery_home', { token: order.token }) }}">
                        A domicile
                    </a>

                    <a href="{{ path('checkout_delivery_relay', { token: order.token, _t: 'now'|date('U') }) }}">
                        En point relais
                    </a>

                </div>
            </section>

            <section id="order_details" class="w-1/3 ml-3">
                <div>
                    Total produit (TVA incluse) {{ order.total }}€
                    <br>
                    <span>
                    Total {{ order.total + order.deliveryPrice }} €
                </span>
                </div>
            </section>


            <section id="delivery-content">
                <div class="w-full">

                    {% for message in app.flashes('error') %}
                        <div class="text-red-600">
                            {{ message }}
                        </div>

                    {% endfor %}

                    {{ form_start(form) }}

                    <div>
                        {{ form_widget(form.relay_id, {'id': 'Target_Widget'}) }}
                    </div>
                    <div>
                        {{ form_row(form.firstname) }}
                    </div>

                    <div>
                        {{ form_row(form.lastname) }}
                    </div>

                    <div>
                        {{ form_row(form.email) }}
                    </div>

                    <div>
                        {{ form_row(form.phoneNumber) }}
                    </div>

                    {% if order.relayId is null or order.relayAddress is null %}
                        <div id="Zone_Widget"></div>
                    {% else %}

                        <div id="relay_info" class="bg-gray-100 p-2 mb-3 rounded">

                            <p>{{ order.relayAddress.street1 }}
                                <br>
                                {% if order.relayAddress.street2 %}
                                    {{ order.relayAddress.street2 }}
                                    <br>
                                {% endif %}
                                {{ order.relayAddress.city }} {{ order.relayAddress.zipcode }}
                                <br>
                                {{ order.relayAddress.country }}
                            </p>

                            <button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 change_relay">Modifier</button>

                        </div>

                        <div id="Zone_Widget" class="hidden"></div>

                    {% endif %}

                    {{ form_errors(form.relay_id) }}

                    {{ form_row(form.CGU) }}

                    {{ form_row(form.submit_relay) }}
                    {{ form_end(form) }}


                </div>
            </section>

        </div>
    </main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_api_key }}"></script>
{% endblock %}
