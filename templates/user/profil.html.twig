{% extends 'base.html.twig' %}

{% block title %}
    Mon Profil
{% endblock %}


{% set header_text = 'var(--dark)' %}
{% set header_bg = 'var(--light)' %}
{% set header_bg_scrolled = 'var(--light)' %}
{% set header_logo = 'dark' %}
{% set footer_bg = 'var(--dark)' %}
{% set footer_text = 'var(--light)' %}

{% block body %}

    <main class="w-full bg-[var(--light)] pt-[15vh] flex flex-col items-center">

        <div class="w-full px-[var(--padX)] text-center">
            <h1 class="text-4xl text-[var(--dark)]">Mon compte</h1>
            <p>Bonjour <span data-value="firstname">{{ activeUser.firstname }}</span></p>
        </div>

        <section class="w-full px-[var(--padX)] mt-10">
            <div class="border border-[#453120]/60 p-8">

                <h2 class="text-3xl text-[var(--dark)] mb-6">Mes dernières commandes</h2>

                {% if lastOrders is not null %}

                    <table class="w-full text-left table-fixed">
                        <thead>
                        <tr class="text-[var(--light)]">
                            <th class="bg-[#453120]/40 px-4 py-3 font-normal rounded-l-xl">Numéro de commande</th>
                            <th class="bg-[#453120]/40 px-4 py-3 font-normal">Date</th>
                            <th class="bg-[#453120]/40 px-4 py-3 font-normal">Montant</th>
                            <th class="bg-[#453120]/40 px-4 py-3 font-normal">Statut</th>
                            <th class="bg-[#453120]/40 px-4 py-3 font-normal rounded-r-xl w-48"></th>
                        </tr>
                        </thead>

                        {% for order in lastOrders %}
                            <tbody class="order {{ loop.index > 2 ? 'extra-order hidden' : '' }}">
                            <tr class="order-summary">
                                <td class="px-4 py-5">{{ order.betterId }}</td>
                                <td class="px-4 py-5">{{ order.creationDate|format_date(pattern='d MMM y', locale='fr') }}</td>
                                <td class="px-4 py-5">{{ order.orderTotal|number_format(2, '.', '') }} €</td>
                                <td class="px-4 py-5">{{ order.status.label }}</td>
                                <td class="px-4 py-5 text-right">
                                    <button type="button"
                                            class="see-order underline cursor-pointer whitespace-nowrap"
                                            aria-expanded="false"
                                            aria-controls="order-details-{{ order.id }}">
                                        Voir la commande
                                    </button>
                                </td>
                            </tr>

                            <tr class="order-details" id="order-details-{{ order.id }}">
                                <td colspan="5" class="p-0">
                                    <div class="details-wrap">
                                        <div class="details-inner">
                                            <div class="px-4 pt-2 pb-6">
                                                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-x-4 gap-y-5">
                                                    {% for item in order.orderItems %}
                                                        <li class="flex gap-2 text-base">
                                                            {% if item.product.mainImage is not null %}
                                                                <img src="{{ vich_uploader_asset(item.product.mainImage, 'imageFile') }}"
                                                                     alt="{{ item.product.name }} - image"
                                                                     class="w-[50px] h-[62px] object-cover shrink-0">
                                                            {% else %}
                                                                <img src="{{ asset('images/site/placeholder.jpg') }}" alt=""
                                                                     class="w-[50px] h-[62px] object-cover shrink-0">
                                                            {% endif %}
                                                            <div class="flex flex-col justify-between">
                                                                <p>{{ item.product.name }}</p>
                                                                <div>
                                                                    <p>Quantité : {{ item.quantity }}</p>
                                                                    <p>{{ item.unitPrice|number_format(2, '.', '') }} €</p>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    {% else %}
                                                        <li class="text-base">Aucun produit pour cette commande.</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        {% endfor %}
                    </table>

                    {% if lastOrders|length > 2 %}
                        <div class="flex justify-end mt-6">
                            <button type="button"
                                    id="toggle-more-orders"
                                    aria-expanded="false"
                                    class="bg-[#453120]/40 text-[var(--light)] text-sm px-4 py-2 rounded-md cursor-pointer">
                                Voir le reste des commandes
                            </button>
                        </div>
                    {% endif %}

                {% else %}

                    <p>Oups, vous n'avez aucune commande</p>


                {% endif %}

            </div>
        </section>

        {% set inputClass = 'w-full bg-[#f4efe2] border-b border-[#453120]/60 px-2 py-1 focus:outline-none focus:border-[var(--dark)]' %}
        {% set rowClass = 'grid grid-cols-1 sm:grid-cols-[14rem_1fr] gap-x-4 gap-y-2 items-start border-b border-[#453120]/60 px-4 py-5' %}

        {% set infoRows = {
            'Prénom': activeUser.firstname,
            'Nom': activeUser.lastname,
            'Adresse e-mail': activeUser.email,
            'Adresse de livraison': activeUser.address ? activeUser.address.oneLine : '—',
            'Mot de passe': '••••••••',
        } %}

        <section class="w-full px-[var(--padX)] mt-10">

            {% for message in app.flashes('success') %}
                <p role="status" class="mb-4">{{ message }}</p>
            {% endfor %}

            {# Si le formulaire revient avec des erreurs, il s'affiche directement ouvert #}
            <div id="profile-info"
                 class="group border border-[#453120]/60 p-8 {{ infoForm.vars.submitted ? 'is-editing' }}"
                 {% if infoForm.vars.submitted %}data-submitted{% endif %}>

                <div class="flex justify-between items-start mb-6">
                    <h3 class="text-3xl text-[var(--dark)]">Mes informations</h3>
                    <button type="button" id="profile-edit"
                            class="group-[.is-editing]:hidden bg-[#453120]/40 text-[var(--light)] text-sm px-4 py-2 rounded-md cursor-pointer">
                        Modifier mes informations
                    </button>
                </div>

                {# ---------- Mode lecture ---------- #}
                <dl class="group-[.is-editing]:hidden">
                    {% for label, value in infoRows %}
                        <div class="{{ rowClass }}">
                            <dt>{{ label }}</dt>
                            <dd>{{ value }}</dd>
                        </div>
                    {% endfor %}
                </dl>

                {# ---------- Mode édition ---------- #}
                <div class="hidden group-[.is-editing]:block">

                    {# Les messages d'erreur (<ul>) de tout le formulaire sont stylés ici, une seule fois #}
                    {{ form_start(infoForm, {attr: {
                        novalidate: 'novalidate',
                        'data-turbo': 'false',
                        class: '[&_ul]:list-none [&_ul]:p-0 [&_ul]:mt-1 [&_ul]:text-sm [&_ul]:text-red-800',
                    }}) }}

                    {{ form_errors(infoForm) }}

                    <div class="{{ rowClass }}">
                        {{ form_label(infoForm.firstname) }}
                        <div>
                            {{ form_widget(infoForm.firstname, {attr: {class: inputClass}}) }}
                            {{ form_errors(infoForm.firstname) }}
                        </div>
                    </div>

                    <div class="{{ rowClass }}">
                        {{ form_label(infoForm.lastname) }}
                        <div>
                            {{ form_widget(infoForm.lastname, {attr: {class: inputClass}}) }}
                            {{ form_errors(infoForm.lastname) }}
                        </div>
                    </div>

                    <div class="{{ rowClass }}">
                        <p class="h-full flex flex-col justify-between">
                            Adresse de livraison <br>
                            <span id="address-erase" class="underline cursor-pointer">Supprimer l'adresse</span>

                        </p>
                        <div id="address-fields" class="grid gap-3">
                            {{ form_widget(infoForm.address.street1, {attr: {class: inputClass, placeholder: 'Adresse'}}) }}
                            {{ form_errors(infoForm.address.street1) }}

                            {{ form_widget(infoForm.address.street2, {attr: {class: inputClass, placeholder: 'Complément d\'adresse (facultatif)'}}) }}
                            {{ form_errors(infoForm.address.street2) }}

                            <div class="grid grid-cols-[8rem_1fr] gap-3">
                                <div>
                                    {{ form_widget(infoForm.address.zipcode, {attr: {class: inputClass, placeholder: 'Code postal'}}) }}
                                    {{ form_errors(infoForm.address.zipcode) }}
                                </div>
                                <div>
                                    {{ form_widget(infoForm.address.city, {attr: {class: inputClass, placeholder: 'Ville'}}) }}
                                    {{ form_errors(infoForm.address.city) }}
                                </div>
                            </div>

                            {{ form_widget(infoForm.address.country, {attr: {class: inputClass}}) }}
                            {{ form_errors(infoForm.address.country) }}
                        </div>
                    </div>

                    <div class="{{ rowClass }}">
                        <span>Adresse e-mail</span>
                        <div>
                            <span>{{ activeUser.email }}</span>
                            <p class="text-base opacity-60 mt-1">L'adresse e-mail ne peut pas être modifiée.</p>
                        </div>
                    </div>

                    <div class="{{ rowClass }}">
                        <span>Mot de passe</span>
                        <div class="grid gap-3">
                            <p class="text-base opacity-60">
                                Laissez ces champs vides pour garder votre mot de passe.
                                Le mot de passe actuel est requis pour en définir un nouveau.
                            </p>

                            {{ form_widget(infoForm.currentPassword, {
                                attr: {
                                    class: inputClass,
                                    placeholder: 'Mot de passe actuel'
                                }
                            }) }}
                            {{ form_errors(infoForm.currentPassword) }}

                            {{ form_widget(infoForm.newPassword, {
                                attr: {
                                    class: inputClass,
                                    placeholder: 'Nouveau mot de passe'
                                }
                            }) }}
                            {{ form_errors(infoForm.newPassword) }}

                            {{ form_widget(infoForm.newPasswordConfirmation, {
                                attr: {
                                    class: inputClass,
                                    placeholder: 'Confirmer le nouveau mot de passe'
                                }
                            }) }}
                            {{ form_errors(infoForm.newPasswordConfirmation) }}
                        </div>
                    </div>

                    <div class="flex justify-end items-center gap-4 mt-6">
                        <a href="{{ path('app_profile') }}" id="profile-cancel" class="underline">Annuler</a>
                        <button type="submit"
                                class="bg-[var(--dark)] text-[var(--light)] text-sm px-5 py-2 rounded-md cursor-pointer">
                            Valider
                        </button>
                    </div>

                    {{ form_end(infoForm) }}
                </div>

            </div>
        </section>

        <div class="flex justify-center my-10">
            <a href="{{ path('app_logout') }}"
               class="bg-[var(--dark)] text-[var(--light)] text-sm px-5 py-2 rounded-md flex items-center">
                <svg class="pr-2" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_726_6992)">
                        <path d="M8.55631 21.2973C7.876 21.2973 7.19568 21.2973 6.51536 21.2973C5.65188 21.2973 4.7884 21.2973 3.89875 21.2973C2.56428 21.2973 1.72696 20.4328 1.7008 19.0968C1.7008 18.7039 1.7008 18.2847 1.7008 17.8918V4.00797C1.7008 3.32688 1.85779 2.82916 2.22412 2.43622C2.64278 1.96469 3.19226 1.72893 3.92491 1.72893C5.44255 1.72893 6.98635 1.72893 8.50398 1.72893C8.66098 1.72893 8.87031 1.70273 9.0273 1.59795C9.3413 1.38838 9.49829 0.995444 9.39363 0.628702C9.31513 0.261959 9.00114 0 8.58248 0C6.96018 0 5.36405 0 3.74175 0C1.64846 0 0 1.65034 0 3.77221C0 5.55353 0 7.30866 0 9.08998V11.5V13.91C0 15.6913 0 17.4465 0 19.2278C0 21.0353 1.22981 22.5547 3.0091 22.9214C3.29693 22.9738 3.58476 22.9738 3.89875 22.9738H3.95108H5.10239C6.2537 22.9738 7.40501 22.9738 8.55631 22.9738C8.81798 22.9738 9.0273 22.8952 9.21047 22.7118C9.36746 22.5547 9.44596 22.3451 9.44596 22.0831C9.44596 21.6378 9.05347 21.2973 8.55631 21.2973Z" fill="#E4D8C5"/>
