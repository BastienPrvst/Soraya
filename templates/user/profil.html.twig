                    </g>
                    <defs>
                        <clipPath id="clip0_726_6992">
                            <rect width="23" height="23" fill="white"/>
                        </clipPath>
                    </defs>
                </svg>
                 Se déconnecter
            </a>
        </div>

    </main>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/profil.js') }}"></script>
{% endblock %}


