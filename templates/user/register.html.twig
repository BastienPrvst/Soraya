        <h1 class="text-4xl self-center text-[var(--dark)]">S'inscrire</h1>

        {{ form_row(form.firstname) }}
        {{ form_row(form.lastname) }}
        {{ form_row(form.email) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.birthday) }}

        <div class="flex flex-col md:flex-row">
            <span>Déjà un compte ? <a class="underline" href="{{ path('app_login') }}">Connectez-vous</a></span>
        </div>

        {{ form_row(form.cgu) }}

        {{ form_row(form.submit) }}

        {{ form_end(form) }}

    </main>

